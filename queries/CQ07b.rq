# CQ07b: Can the records of an event be paired in time (are timestamps present in all of them)?
#
# Example ForestFire-VQA questions answered by this query:
#   - Are timestamps present in both records (for temporal pairing)?

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffontov:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?eventCode ?record ?modality ?captureTime ?hasTimestamp
WHERE {
  ?record ffonto:aboutEvent/ffonto:eventCode ?eventCode ; a ?type .
  VALUES ?type { ffonto:ImageRecord ffonto:AudioRecord }
  BIND(STRAFTER(STR(?type), "#") AS ?modality)
  OPTIONAL { ?record ffonto:captureTime ?captureTime }
  BIND(BOUND(?captureTime) AS ?hasTimestamp)
}
ORDER BY ?eventCode ?modality

# CQ22: What post-fire burn evidence is visible?
#
# Example ForestFire-VQA questions answered by this query:
#   - Is white/gray ash visible?
#   - Are snags (dead standing trees) common?
#   - Is mineral soil exposed?
#   - Are early signs of regrowth visible?
#   - Are erosion rills forming on slopes?
#   - Is a recent retardant line visible?
#
# Note: Burn-severity level and ash colour can be reported as scene attributes (BurnSeverity, AshColour) and queried like CQ12.

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffv:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?record ?entity ?kind ?count
       (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?stateL, ""); separator=", "), "^(, )+|(, )+$", ""), "(, )(2,)", ", ") AS ?states)
WHERE {
  ?sd ffonto:describesRecord ?record ; ffonto:depicts ?entity .
  ?entity ffonto:hasKind ?k .
  VALUES ?top { ffv:BurnEvidenceKind }
  ?k skos:broader* ?top ; skos:prefLabel ?kind .
  OPTIONAL { ?entity ffonto:count ?count }
  OPTIONAL { ?entity ffonto:hasState ?st . ?st skos:prefLabel ?stateL }
}
GROUP BY ?record ?entity ?kind ?count
ORDER BY ?record ?kind

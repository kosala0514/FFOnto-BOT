# CQ03: Which model produced each observation / caption / scene description, from which label source, and was it human-validated?
#
# Example ForestFire-VQA questions answered by this query:
#   - Which vision model produced the scores (name/version)?
#   - Which caption model produced the caption?
#   - What is the label_source?
#   - Is the model provenance (repo/URL) recorded?
#   - Was the decision human-validated or auto-labeled?
#   - What is the frame stride used by the model?
#   - Is the class map checksum recorded?

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffv:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT DISTINCT ?record ?output ?class ?labelSource ?modelName ?modelVersion ?modelURL ?frameStrideS ?classMapSHA1 ?humanValidated
WHERE {
  {
    ?record ffonto:hasObservation ?o .
    ?o prov:wasAttributedTo ?m ; ffonto:predictedClass ?class .
    OPTIONAL { ?o ffonto:labelSource ?labelSource }
    BIND("classifier observation" AS ?output)
  }
  UNION
  {
    ?record ffonto:hasCaption ?c .
    ?c prov:wasAttributedTo ?m .
    BIND("caption" AS ?output)
  }
  UNION
  {
    ?sd ffonto:describesRecord ?record ; prov:wasAttributedTo ?m .
    OPTIONAL { ?sd ffonto:humanValidated ?humanValidated }
    BIND("scene description" AS ?output)
  }
  ?m ffonto:modelName ?modelName .
  OPTIONAL { ?m ffonto:modelVersion ?modelVersion }
  OPTIONAL { ?m ffonto:modelURL ?modelURL }
  OPTIONAL { ?m ffonto:frameStrideS ?frameStrideS }
  OPTIONAL { ?m ffonto:classMapSHA1 ?classMapSHA1 }
}
ORDER BY ?record ?output

# CQ15: What are the visibility, sky and light conditions in the scene?
#
# Example ForestFire-VQA questions answered by this query:
#   - Is scene visibility low, medium, or high due to smoke?
#   - Is the sky clear?
#   - Is there any fog?
#   - Is it nighttime or very low light?
#   - Is the air quality good or poor?

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffontov:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?record ?property ?value ?producedBy
WHERE {
  ?sd ffonto:describesRecord ?record ; ffonto:hasObservation ?o .
  VALUES ?p { ffontov:VisibilityLevel ffontov:SkyCondition ffontov:LightCondition ffontov:AirQualityLevel }
  ?o sosa:observedProperty ?p ; ffonto:hasValueConcept ?v .
  ?p skos:prefLabel ?property .
  ?v skos:prefLabel ?value .
  OPTIONAL { ?o prov:wasAttributedTo/ffonto:modelName ?producedBy }
}
ORDER BY ?record ?property

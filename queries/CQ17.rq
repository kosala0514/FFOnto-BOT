# CQ17: Which PPE does each person wear, and which required PPE is missing?
#
# Example ForestFire-VQA questions answered by this query:
#   - Are firefighters wearing helmets?
#   - Are gloves visible on the firefighters?
#   - What type of protective equipment are they wearing?
#   - Are any firefighters missing obvious PPE?
#   - Are respirators or masks visible?

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffv:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?record ?person ?kind ?count
       (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?wornL, ""); separator=", "), "^(, )+|(, )+$", ""), "(, ){2,}", ", ") AS ?wearing)
       (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?missingL, ""); separator=", "), "^(, )+|(, )+$", ""), "(, ){2,}", ", ") AS ?missingRequiredPPE)
WHERE {
  ?sd ffonto:describesRecord ?record ; ffonto:depicts ?person .
  ?person ffonto:hasKind ?k .
  ?k skos:broader* ffv:Person ; skos:prefLabel ?kind .
  OPTIONAL { ?person ffonto:count ?count }
  OPTIONAL { ?person ffonto:wears ?w . ?w skos:prefLabel ?wornL }
  OPTIONAL { ?k ffonto:requiredPPE ?req .
             FILTER NOT EXISTS { ?person ffonto:wears ?req }
             ?req skos:prefLabel ?missingL }
}
GROUP BY ?record ?person ?kind ?count
ORDER BY ?record ?person

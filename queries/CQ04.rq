# CQ04: What score / confidence did the models assign to each class for each record?
#
# Example ForestFire-VQA questions answered by this query:
#   - What is the model's fire probability score for this image?
#   - What is the smoke score?
#   - What is the no-fire score?
#   - What severity label was assigned?
#   - How many labels are attached to this image record?

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffontov:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?record ?class ?confidence ?severity ?labelSource ?nLabelsOnRecord
WHERE {
  ?record ffonto:hasObservation ?o .
  ?o ffonto:predictedClass ?class ; ffonto:confidence ?confidence .
  OPTIONAL { ?o ffonto:severity ?severity }
  OPTIONAL { ?o ffonto:labelSource ?labelSource }
  {
    SELECT ?record (COUNT(?x) AS ?nLabelsOnRecord)
    WHERE { ?record ffonto:hasObservation ?x . ?x ffonto:predictedClass ?anyClass }
    GROUP BY ?record
  }
}
ORDER BY ?record DESC(?confidence)

# CQ12: What are the properties of the smoke in the scene?
#
# Example ForestFire-VQA questions answered by this query:
#   - What's the color of the smoke?
#   - How thick is the smoke?
#   - Is the smoke plume rising vertically or drifting horizontally?
#   - How tall is the smoke plume?
#   - Are multiple smoke layers present?
#
# Note: 'Is smoke present above the detection threshold?' is answered by CQ05 (classifier) — this query answers the visual attributes.

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffontov:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?record ?property ?value ?producedBy
WHERE {
  ?sd ffonto:describesRecord ?record ; ffonto:hasObservation ?o .
  VALUES ?p { ffontov:SmokeColour ffontov:SmokeDensity ffontov:PlumeDirection ffontov:PlumeHeight ffontov:SmokeLayering }
  ?o sosa:observedProperty ?p ; ffonto:hasValueConcept ?v .
  ?p skos:prefLabel ?property .
  ?v skos:prefLabel ?value .
  OPTIONAL { ?o prov:wasAttributedTo/ffonto:modelName ?producedBy }
}
ORDER BY ?record ?property

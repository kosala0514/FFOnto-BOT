# CQ11: Which fire phenomena are present in the scene, and how many?
#
# Example ForestFire-VQA questions answered by this query:
#   - Are flame fronts visible?
#   - Are multiple distinct flame fronts visible?
#   - Are spot fires visible ahead of the main flames?
#   - Are crown fires visible?
#   - Is a pyrocumulus cloud forming?
#   - Are multiple fire clusters detected?

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffv:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?record ?phenomenon (SUM(COALESCE(?n, 1)) AS ?count) (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?posL, ""); separator=", "), "^(, )+|(, )+$", ""), "(, ){2,}", ", ") AS ?positions)
WHERE {
  ?sd ffonto:describesRecord ?record ; ffonto:depicts ?e .
  ?e ffonto:hasKind ?k .
  ?k skos:broader* ffv:FirePhenomenonKind ; skos:prefLabel ?phenomenon .
  OPTIONAL { ?e ffonto:count ?n }
  OPTIONAL { ?e ffonto:relativePosition ?pos . ?pos skos:prefLabel ?posL }
}
GROUP BY ?record ?phenomenon
ORDER BY ?record ?phenomenon

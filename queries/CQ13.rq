# CQ13: What is the fire type, behaviour, intensity and status in the scene?
#
# Example ForestFire-VQA questions answered by this query:
#   - Is the fire primarily a surface/ground fire or crown fire?
#   - Is the fire intensity high or low?
#   - Is the fire perimeter expanding?
#   - What environmental process might be occurring (controlled burn vs wildfire)?
#   - Is this incident under control or still a spreading threat?

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffontov:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?record ?property ?value ?producedBy
WHERE {
  ?sd ffonto:describesRecord ?record ; ffonto:hasObservation ?o .
  VALUES ?p { ffontov:FireType ffontov:FireIntensity ffontov:FireSpreadStatus ffontov:FireActivityTrend ffontov:ScenePurpose }
  ?o sosa:observedProperty ?p ; ffonto:hasValueConcept ?v .
  ?p skos:prefLabel ?property .
  ?v skos:prefLabel ?value .
  OPTIONAL { ?o prov:wasAttributedTo/ffonto:modelName ?producedBy }
}
ORDER BY ?record ?property

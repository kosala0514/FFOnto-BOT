# CQ09: What are the FWI components, fire occurrence and burned area for a site/date, and how is FWI trending?
#
# Example ForestFire-VQA questions answered by this query:
#   - What are today's FFMC and ISI values?
#   - What are today's BUI and overall FWI values?
#   - Is fire occurred flagged in this row?
#   - What's the current size of the fire (ha)?
#   - Are detections increasing or decreasing compared to the previous update?

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffv:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?w ?site ?date ?FFMC ?DMC ?DC ?ISI ?BUI ?FWI ?fireOccurred ?areaHa ?previousDate ?previousFWI ?fwiTrend
WHERE {
  ?w a ffonto:WeatherRecord ; ffonto:atSite/ffonto:siteName ?site .
  OPTIONAL { ?w ffonto:observationDate ?date }
  OPTIONAL { ?w ffonto:ffmc ?FFMC }
  OPTIONAL { ?w ffonto:dmc ?DMC }
  OPTIONAL { ?w ffonto:dc ?DC }
  OPTIONAL { ?w ffonto:isi ?ISI }
  OPTIONAL { ?w ffonto:bui ?BUI }
  OPTIONAL { ?w ffonto:fwi ?FWI }
  OPTIONAL { ?w ffonto:fireOccurred ?fireOccurred }
  OPTIONAL { ?w ffonto:burnedAreaHa ?areaHa }
  OPTIONAL { ?w ffonto:previousRecord ?wPrev .            # derived by rule R08
             ?wPrev ffonto:observationDate ?previousDate .
             OPTIONAL { ?wPrev ffonto:fwi ?previousFWI } }
  BIND(IF(!BOUND(?previousFWI) || !BOUND(?FWI), "n/a",
       IF(?FWI > ?previousFWI, "increasing", IF(?FWI < ?previousFWI, "decreasing", "stable"))) AS ?fwiTrend)
}
ORDER BY ?site ?date

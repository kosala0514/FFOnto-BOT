# CQ14: Which vegetation, terrain, water and land-cover features are in the scene, and in what condition?
#
# Example ForestFire-VQA questions answered by this query:
#   - What type of vegetation is burning?
#   - Is the vegetation dry?
#   - Are the trees green or dead?
#   - Is there any water source nearby?
#   - What is the dominant land cover?
#   - Is there ice or snow on the ground?
#   - What type of forest is present?
#
# Note: Vegetation-level attributes (FuelCondition, VegetationDensity, DominantAspect …) can be added to the scene 'attributes' and queried like CQ12.

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffv:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?record ?entity ?kind ?count
       (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?stateL, ""); separator=", "), "^(, )+|(, )+$", ""), "(, )(2,)", ", ") AS ?states) ?group
WHERE {
  ?sd ffonto:describesRecord ?record ; ffonto:depicts ?entity .
  ?entity ffonto:hasKind ?k .
  VALUES ?top { ffv:EnvironmentFeatureKind }
  ?k skos:broader* ?top ; skos:prefLabel ?kind .
  OPTIONAL { ?entity ffonto:count ?count }
  OPTIONAL { ?entity ffonto:hasState ?st . ?st skos:prefLabel ?stateL }
  OPTIONAL { ?k skos:broader* ?g . ?g skos:broader ffv:EnvironmentFeatureKind ; skos:prefLabel ?group }
}
GROUP BY ?record ?entity ?kind ?count ?group
ORDER BY ?record ?kind

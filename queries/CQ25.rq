# CQ25: Which protective / operational actions are recommended for the hazards found?
#
# Example ForestFire-VQA questions answered by this query:
#   - Should residents shelter in place or evacuate immediately?
#   - What safety precautions should responders prioritize here?
#   - What protective actions should be taken for civilian areas?
#   - Are aerial firefighting resources necessary in this scenario?

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffv:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?eventCode ?hazardType (GROUP_CONCAT(DISTINCT ?actionL; separator="; ") AS ?recommendedActions)
WHERE {
  ?h a ffonto:Hazard ; ffonto:hasHazardType ?ht .
  ?ht skos:prefLabel ?hazardType ; ffonto:mitigatedBy ?a .
  ?a skos:prefLabel ?actionL .
  OPTIONAL { ?h ffonto:inEvent/ffonto:eventCode ?eventCode }
}
GROUP BY ?eventCode ?hazardType
ORDER BY ?eventCode ?hazardType

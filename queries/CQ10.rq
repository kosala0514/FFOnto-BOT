# CQ10: Which operational conditions do the weather / FWI values imply (via danger rules)?
#
# Example ForestFire-VQA questions answered by this query:
#   - Is wind speed high enough to reduce aerial drop effectiveness?
#   - Does low relative humidity favor direct attack with hand tools today?
#   - Do ISI/FFMC values indicate rapid fine-fuel spread (favor indirect tactics)?
#   - Does the weather indicate elevated fire danger?
#   - Is heat stress a concern given temp/RH?
#   - Has any rain today improved conditions for mop-up?
#
# Note: A condition that is NOT listed for a date did not fire, i.e. the answer to the yes/no question is 'no'.

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffontov:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?w ?site ?date ?condition ?ruleLabel ?property ?operator ?threshold ?observedValue
WHERE {
  ?w ffonto:hasCondition ?c ; ffonto:atSite/ffonto:siteName ?site .
  OPTIONAL { ?w ffonto:observationDate ?date }
  ?c skos:prefLabel ?condition .
  ?rule a ffonto:DangerRule ; ffonto:indicatesCondition ?c ; ffonto:onProperty ?property ;
        ffonto:operator ?operator ; ffonto:thresholdValue ?threshold ; rdfs:label ?ruleLabel .
  ?w ?property ?observedValue .
  FILTER( (?operator = "gt" && ?observedValue >  ?threshold) || (?operator = "ge" && ?observedValue >= ?threshold) ||
          (?operator = "lt" && ?observedValue <  ?threshold) || (?operator = "le" && ?observedValue <= ?threshold) )
}
ORDER BY ?site ?date ?condition

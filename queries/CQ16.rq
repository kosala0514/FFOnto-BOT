# CQ16: Which people and animals are in the scene, how many, and what are they doing?
#
# Example ForestFire-VQA questions answered by this query:
#   - Are there firefighters on the ground?
#   - Are people evacuating?
#   - Are firefighters retreating from the flames?
#   - Are there animals or civilians present?
#   - Are responders guiding traffic?
#   - Are firefighters performing mop-up?

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffontov:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?record ?entity ?kind ?count
       (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?stateL, ""); separator=", "), "^(, )+|(, )+$", ""), "(, )(2,)", ", ") AS ?states)
       (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?actL, ""); separator=", "), "^(, )+|(, )+$", ""), "(, ){2,}", ", ") AS ?activities)
WHERE {
  ?sd ffonto:describesRecord ?record ; ffonto:depicts ?entity .
  ?entity ffonto:hasKind ?k .
  VALUES ?top { ffontov:AgentKind }
  ?k skos:broader* ?top ; skos:prefLabel ?kind .
  OPTIONAL { ?entity ffonto:count ?count }
  OPTIONAL { ?entity ffonto:hasState ?st . ?st skos:prefLabel ?stateL }
  OPTIONAL { ?entity ffonto:performs ?act . ?act skos:prefLabel ?actL }
}
GROUP BY ?record ?entity ?kind ?count
ORDER BY ?record ?kind

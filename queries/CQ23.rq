# CQ23: Which sound events are detected in each audio clip, for how long, and with what confidence?
#
# Example ForestFire-VQA questions answered by this query:
#   - Is an explosion detected in the latest audio clip?
#   - What is the mean confidence of the detected audio event?
#   - What is the maximum confidence?
#   - What is the duration of the audio clip?
#   - Is the audio clip longer than 60 seconds?
#   - What top-k frame labels were detected?
#   - Are sirens audible in the clip?

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffontov:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?record ?eventCode ?durationS ?longerThan60s ?soundEvent ?meanConfidence ?maxConfidence ?threshold ?aboveThreshold
       (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?tk, ""); separator=", "), "^(, )+|(, )+$", ""), "(, ){2,}", ", ") AS ?topKFrameLabels)
WHERE {
  ?record a ffonto:AudioRecord ; ffonto:hasObservation ?o .
  OPTIONAL { ?record ffonto:aboutEvent/ffonto:eventCode ?eventCode }
  OPTIONAL { ?record ffonto:durationMs ?ms }
  BIND(?ms / 1000 AS ?durationS)
  BIND(IF(BOUND(?ms), ?ms > 60000, ?unbound) AS ?longerThan60s)
  ?o ffonto:predictedClass ?cls .
  ?cls skos:prefLabel ?soundEvent .
  OPTIONAL { ?o ffonto:meanConfidence ?meanConfidence }
  OPTIONAL { ?o ffonto:maxConfidence ?maxConfidence }
  OPTIONAL { ?o ffonto:usedThreshold/ffonto:thresholdValue ?threshold }
  OPTIONAL { ?o ffonto:aboveThreshold ?aboveThreshold }
  OPTIONAL { ?o ffonto:topKLabel ?tk }
}
GROUP BY ?record ?eventCode ?durationS ?longerThan60s ?soundEvent ?meanConfidence ?maxConfidence ?threshold ?aboveThreshold
ORDER BY ?record DESC(?meanConfidence)

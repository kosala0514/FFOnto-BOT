# CQ24: Which hazards exist, and what do they threaten?
#
# Example ForestFire-VQA questions answered by this query:
#   - Are safety risks present for firefighters?
#   - Is the structure at risk?
#   - Are responders at risk from exploding materials?
#   - Is visibility for drivers compromised?
#   - Could ember spotting occur beyond the visible fire front?
#   - Is there infrastructure at risk nearby?
#   - What is the primary risk to firefighters in this scenario?

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffv:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?eventCode ?hazardType ?threatened ?evidence ?reason
WHERE {
  ?h a ffonto:Hazard ; ffonto:hasHazardType ?ht .
  ?ht skos:prefLabel ?hazardType .
  OPTIONAL { ?h ffonto:inEvent/ffonto:eventCode ?eventCode }
  OPTIONAL { ?h ffonto:threatens/ffonto:hasKind/skos:prefLabel ?threatened }
  OPTIONAL { ?h prov:wasDerivedFrom ?src .
             OPTIONAL { ?src ffonto:hasKind/skos:prefLabel ?srcKind }
             OPTIONAL { ?src sosa:observedProperty/skos:prefLabel ?srcProp }
             OPTIONAL { ?src ffonto:predictedClass/skos:prefLabel ?srcClass } }
  OPTIONAL { ?h rdfs:comment ?reason }
  BIND(COALESCE(?srcKind, ?srcProp, ?srcClass) AS ?evidence)
}
ORDER BY ?eventCode ?hazardType

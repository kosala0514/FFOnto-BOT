@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ffonto: <http://purl.org/ffonto#> .
@prefix ffr: <http://purl.org/ffonto/data/rule/> .
@prefix ffv: <http://purl.org/ffonto/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:contributor a owl:AnnotationProperty ;
    rdfs:label "contributor"@en .

dcterms:created a owl:AnnotationProperty ;
    rdfs:label "created"@en .

dcterms:creator a owl:AnnotationProperty ;
    rdfs:label "creator"@en .

dcterms:description a owl:AnnotationProperty ;
    rdfs:label "description"@en .

dcterms:license a owl:AnnotationProperty ;
    rdfs:label "license"@en .

dcterms:title a owl:AnnotationProperty ;
    rdfs:label "title"@en .

<http://purl.org/ffonto> a owl:Ontology ;
    dcterms:contributor "Prof. Dulani Meedeniya" ;
    dcterms:created "2026-10-07"^^xsd:date ;
    dcterms:creator "Charuni Kosala Jayaweera" ;
    dcterms:description "Minimal, competency-question-driven ontology for multimodal (image, audio, tabular) forest-fire knowledge graphs, aligned with the ForestFire-VQA dataset."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Forest Fire Ontology (FFOnto) – core"@en ;
    vann:preferredNamespacePrefix "ffo" ;
    vann:preferredNamespaceUri "http://purl.org/ffonto#" ;
    rdfs:comment "SOSA, PROV-O, SKOS and Dublin Core terms are reused by IRI and declared below (no owl:imports), so the ontology loads offline and stays in OWL 2 DL. To import the full external ontologies, add owl:imports and a catalog entry."@en ;
    owl:versionIRI <http://purl.org/ffonto/2.0.0> ;
    owl:versionInfo "2.0.0" .

ffonto:aboutEvent a owl:ObjectProperty ;
    rdfs:label "about event"@en ;
    rdfs:comment "Links a record to the fire event it documents (from event_id). This is the cross-modal join key."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range ffonto:FireEvent .

ffonto:aboveThreshold a owl:DatatypeProperty ;
    rdfs:label "above threshold"@en ;
    rdfs:comment "DERIVED (rule R01)."@en ;
    rdfs:domain ffonto:ModelObservation ;
    rdfs:range xsd:boolean .

ffonto:advancingToward a owl:ObjectProperty ;
    rdfs:label "advancing toward"@en ;
    rdfs:comment "The subject (typically fire) is moving toward the object in the frame."@en ;
    rdfs:domain ffonto:SceneEntity ;
    rdfs:range ffonto:SceneEntity ;
    rdfs:subPropertyOf ffonto:spatiallyRelated .

ffonto:atSite a owl:ObjectProperty ;
    rdfs:label "at site"@en ;
    rdfs:comment "Links a record to the site or grid cell where it was captured."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range ffonto:Site .

ffonto:bands a owl:DatatypeProperty ;
    rdfs:label "bands"@en ;
    rdfs:comment "Spectral bands of the image (e.g. RGB, IR)."@en ;
    rdfs:domain ffonto:ImageRecord ;
    rdfs:range xsd:string .

ffonto:blocks a owl:ObjectProperty ;
    rdfs:label "blocks"@en ;
    rdfs:comment "The subject obstructs the object (e.g. a fallen tree blocks a road)."@en ;
    rdfs:domain ffonto:SceneEntity ;
    rdfs:range ffonto:SceneEntity ;
    rdfs:subPropertyOf ffonto:spatiallyRelated .

ffonto:blur a owl:DatatypeProperty ;
    rdfs:label "blur quality value"@en ;
    rdfs:comment "Blur quality value recorded for the image."@en ;
    rdfs:domain ffonto:ImageRecord ;
    rdfs:range xsd:double .

ffonto:bui a owl:DatatypeProperty ;
    rdfs:label "BUI"@en ;
    rdfs:comment "Buildup Index"@en ;
    rdfs:domain ffonto:WeatherRecord ;
    rdfs:range xsd:double .

ffonto:burnedAreaHa a owl:DatatypeProperty ;
    rdfs:label "burned area (ha)"@en ;
    rdfs:comment "Burned area in hectares."@en ;
    rdfs:domain ffonto:WeatherRecord ;
    rdfs:range xsd:double .

ffonto:captionText a owl:DatatypeProperty ;
    rdfs:label "caption text"@en ;
    rdfs:comment "Text of a generated caption."@en ;
    rdfs:domain ffonto:Caption ;
    rdfs:range xsd:string .

ffonto:captureTime a owl:DatatypeProperty ;
    rdfs:label "capture time (UTC)"@en ;
    rdfs:comment "UTC time at which the record was captured."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range xsd:dateTime .

ffonto:capturedBy a owl:ObjectProperty ;
    rdfs:label "captured by"@en ;
    rdfs:comment "Links a record to the physical device (camera, microphone, station) that captured it."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range ffonto:CaptureDevice .

ffonto:centerWKT a owl:DatatypeProperty ;
    rdfs:label "center (WKT)"@en ;
    rdfs:comment "Centre point of the record as WKT text."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range xsd:string .

ffonto:checksumSHA256 a owl:DatatypeProperty ;
    rdfs:label "checksum SHA-256"@en ;
    rdfs:comment "SHA-256 checksum of the media file, for integrity and audit."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range xsd:string .

ffonto:classMapSHA1 a owl:DatatypeProperty ;
    rdfs:label "class map SHA-1"@en ;
    rdfs:comment "SHA-1 checksum of the model's class map, for audit."@en ;
    rdfs:domain ffonto:Model ;
    rdfs:range xsd:string .

ffonto:cloudCover a owl:DatatypeProperty ;
    rdfs:label "cloud cover quality value"@en ;
    rdfs:comment "Cloud-cover quality value recorded for the image."@en ;
    rdfs:domain ffonto:ImageRecord ;
    rdfs:range xsd:double .

ffonto:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence"@en ;
    rdfs:comment "Confidence or score of an observation (for audio: mean confidence)."@en ;
    rdfs:domain ffonto:ModelObservation ;
    rdfs:range xsd:double .

ffonto:conflictType a owl:ObjectProperty ;
    rdfs:label "conflict type"@en ;
    rdfs:comment "Type of a derived modality conflict (ffv:ConflictScheme)."@en ;
    rdfs:domain ffonto:ModalityConflict ;
    rdfs:range skos:Concept .

ffonto:count a owl:DatatypeProperty ;
    rdfs:label "count"@en ;
    rdfs:comment "Number of instances represented by a scene entity (e.g. 3 firefighters)."@en ;
    rdfs:domain ffonto:SceneEntity ;
    rdfs:range xsd:integer .

ffonto:country a owl:DatatypeProperty ;
    rdfs:label "country"@en ;
    rdfs:comment "Country of a site."@en ;
    rdfs:domain ffonto:Site ;
    rdfs:range xsd:string .

ffonto:crs a owl:DatatypeProperty ;
    rdfs:label "coordinate reference system"@en ;
    rdfs:comment "Coordinate reference system of the record's geometry (e.g. EPSG:4326)."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range xsd:string .

ffonto:dayName a owl:DatatypeProperty ;
    rdfs:label "day name"@en ;
    rdfs:comment "Day-of-week name as given in the source table."@en ;
    rdfs:domain ffonto:WeatherRecord ;
    rdfs:range xsd:string .

ffonto:depicts a owl:ObjectProperty ;
    rdfs:label "depicts"@en ;
    rdfs:comment "Links a scene description to an entity visible in the image."@en ;
    rdfs:domain ffonto:SceneDescription ;
    rdfs:range ffonto:SceneEntity .

ffonto:describesRecord a owl:ObjectProperty ;
    rdfs:label "describes record"@en ;
    rdfs:comment "Links a scene description to the image record it describes."@en ;
    rdfs:domain ffonto:SceneDescription ;
    rdfs:range ffonto:ImageRecord .

ffonto:detectedClass a owl:ObjectProperty ;
    rdfs:label "detected class"@en ;
    rdfs:comment "DERIVED (rule R02): a class whose observation confidence reached its threshold."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range skos:Concept .

ffonto:deviceId a owl:DatatypeProperty ;
    rdfs:label "device id"@en ;
    rdfs:comment "Identifier of the capture device."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range xsd:string .

ffonto:dmc a owl:DatatypeProperty ;
    rdfs:label "DMC"@en ;
    rdfs:comment "Duff Moisture Code"@en ;
    rdfs:domain ffonto:WeatherRecord ;
    rdfs:range xsd:double .

ffonto:durationMs a owl:DatatypeProperty ;
    rdfs:label "duration (ms)"@en ;
    rdfs:comment "Duration of the audio clip in milliseconds."@en ;
    rdfs:domain ffonto:AudioRecord ;
    rdfs:range xsd:double .

ffonto:eventCode a owl:DatatypeProperty ;
    rdfs:label "event code"@en ;
    rdfs:comment "Original event identifier string (event_id)."@en ;
    rdfs:domain ffonto:FireEvent ;
    rdfs:range xsd:string .

ffonto:fileURI a owl:DatatypeProperty ;
    rdfs:label "file URI / path"@en ;
    rdfs:comment "Path or URI of the media file."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range xsd:string .

ffonto:fireOccurred a owl:DatatypeProperty ;
    rdfs:label "fire occurred"@en ;
    rdfs:comment "Whether a fire occurred on this date at this site (fire_occured)."@en ;
    rdfs:domain ffonto:WeatherRecord ;
    rdfs:range xsd:boolean .

ffonto:footprintWKT a owl:DatatypeProperty ;
    rdfs:label "footprint (WKT)"@en ;
    rdfs:comment "Spatial footprint of the record as WKT text."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range xsd:string .

ffonto:forClass a owl:ObjectProperty ;
    rdfs:label "for class"@en ;
    rdfs:comment "The class a threshold applies to."@en ;
    rdfs:domain ffonto:Threshold ;
    rdfs:range skos:Concept .

ffonto:frameStrideS a owl:DatatypeProperty ;
    rdfs:label "frame stride (s)"@en ;
    rdfs:comment "Frame stride of an audio model in seconds."@en ;
    rdfs:domain ffonto:Model ;
    rdfs:range xsd:double .

ffonto:georeferenced a owl:DatatypeProperty ;
    rdfs:label "georeferenced"@en ;
    rdfs:comment "Whether the record carries georeference information."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range xsd:boolean .

ffonto:globalThreshold a owl:DatatypeProperty ;
    rdfs:label "global detection threshold"@en ;
    rdfs:comment "Global detection threshold configured for the audio tagger."@en ;
    rdfs:domain ffonto:AudioRecord ;
    rdfs:range xsd:double .

ffonto:gridX a owl:DatatypeProperty ;
    rdfs:label "grid x"@en ;
    rdfs:comment "X coordinate of the site's grid cell."@en ;
    rdfs:domain ffonto:Site ;
    rdfs:range xsd:integer .

ffonto:gridY a owl:DatatypeProperty ;
    rdfs:label "grid y"@en ;
    rdfs:comment "Y coordinate of the site's grid cell."@en ;
    rdfs:domain ffonto:Site ;
    rdfs:range xsd:integer .

ffonto:hasCaption a owl:ObjectProperty ;
    rdfs:label "has caption"@en ;
    rdfs:comment "Links an image record to the caption generated for it."@en ;
    rdfs:domain ffonto:ImageRecord ;
    rdfs:range ffonto:Caption .

ffonto:hasCondition a owl:ObjectProperty ;
    rdfs:label "has condition"@en ;
    rdfs:comment "DERIVED (rule R04): operational condition implied by a danger rule."@en ;
    rdfs:domain ffonto:WeatherRecord ;
    rdfs:range skos:Concept .

ffonto:hasHazardType a owl:ObjectProperty ;
    rdfs:label "has hazard type"@en ;
    rdfs:comment "Type of a derived hazard (ffv:HazardScheme)."@en ;
    rdfs:domain ffonto:Hazard ;
    rdfs:range skos:Concept .

ffonto:hasKind a owl:ObjectProperty ;
    rdfs:label "has kind"@en ;
    rdfs:comment "Fine-grained kind of a scene entity, from ffv:EntityKindScheme (e.g. ffv:Pulaski, ffv:Firefighter)."@en ;
    rdfs:domain ffonto:SceneEntity ;
    rdfs:range skos:Concept .

ffonto:hasObservation a owl:ObjectProperty ;
    rdfs:label "has observation"@en ;
    rdfs:comment "Links a record or a scene description to the model observations made about it."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ffonto:DataRecord ffonto:SceneDescription ) ] ;
    rdfs:range ffonto:ModelObservation .

ffonto:hasState a owl:ObjectProperty ;
    rdfs:label "has state"@en ;
    rdfs:comment "Visible state or condition of a scene entity (ffv:StateScheme), e.g. Scorched, Blocked, Dry."@en ;
    rdfs:domain ffonto:SceneEntity ;
    rdfs:range skos:Concept .

ffonto:hasValueConcept a owl:ObjectProperty ;
    rdfs:label "has value concept"@en ;
    rdfs:comment "Categorical result of an observation (e.g. SmokeColour → Gray)."@en ;
    rdfs:domain ffonto:ModelObservation ;
    rdfs:range skos:Concept .

ffonto:heightPx a owl:DatatypeProperty ;
    rdfs:label "height (px)"@en ;
    rdfs:comment "Image height in pixels."@en ;
    rdfs:domain ffonto:ImageRecord ;
    rdfs:range xsd:integer .

ffonto:humanValidated a owl:DatatypeProperty ;
    rdfs:label "human validated"@en ;
    rdfs:comment "Whether a human has validated the output."@en ;
    rdfs:domain ffonto:SceneDescription ;
    rdfs:range xsd:boolean .

ffonto:inEvent a owl:ObjectProperty ;
    rdfs:label "in event"@en ;
    rdfs:comment "Event context of a derived hazard or conflict."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ffonto:Hazard ffonto:ModalityConflict ) ] ;
    rdfs:range ffonto:FireEvent .

ffonto:indicatesCondition a owl:ObjectProperty ;
    rdfs:label "indicates condition"@en ;
    rdfs:comment "The operational condition a danger rule indicates when it fires."@en ;
    rdfs:domain ffonto:DangerRule ;
    rdfs:range skos:Concept .

ffonto:involvesObservation a owl:ObjectProperty ;
    rdfs:label "involves observation"@en ;
    rdfs:comment "An observation that takes part in a modality conflict."@en ;
    rdfs:domain ffonto:ModalityConflict ;
    rdfs:range ffonto:ModelObservation .

ffonto:labelCategory a owl:DatatypeProperty ;
    rdfs:label "label category"@en ;
    rdfs:comment "Category of a raw label as given by the pipeline (e.g. fire_audio)."@en ;
    rdfs:domain ffonto:ModelObservation ;
    rdfs:range xsd:string .

ffonto:labelSource a owl:ObjectProperty ;
    rdfs:label "label source"@en ;
    rdfs:comment "Where the label of an observation came from (caption, zero-shot, detector, audio tagger, VLM, human)."@en ;
    rdfs:domain ffonto:ModelObservation ;
    rdfs:range skos:Concept .

ffonto:maxConfidence a owl:DatatypeProperty ;
    rdfs:label "max confidence"@en ;
    rdfs:comment "Maximum frame-level confidence of an audio event."@en ;
    rdfs:domain ffonto:ModelObservation ;
    rdfs:range xsd:double .

ffonto:meanConfidence a owl:DatatypeProperty ;
    rdfs:label "mean confidence"@en ;
    rdfs:comment "Mean frame-level confidence of an audio event."@en ;
    rdfs:domain ffonto:ModelObservation ;
    rdfs:range xsd:double .

ffonto:mediaId a owl:DatatypeProperty ;
    rdfs:label "media id"@en ;
    rdfs:comment "Identifier of the media item (image_id)."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range xsd:string .

ffonto:mentionsConcept a owl:ObjectProperty ;
    rdfs:label "mentions concept"@en ;
    rdfs:comment "DERIVED (rule R03): the caption text contains one of the concept's labels."@en ;
    rdfs:domain ffonto:Caption ;
    rdfs:range skos:Concept .

ffonto:mitigatedBy a owl:ObjectProperty ;
    rdfs:label "mitigated by"@en ;
    rdfs:comment "Hazard concept → recommended action concept."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept .

ffonto:modelName a owl:DatatypeProperty ;
    rdfs:label "model name"@en ;
    rdfs:comment "Name or repository id of a model."@en ;
    rdfs:domain ffonto:Model ;
    rdfs:range xsd:string .

ffonto:modelURL a owl:DatatypeProperty ;
    rdfs:label "model provenance URL"@en ;
    rdfs:comment "URL documenting the model's provenance (e.g. TF-Hub or Hugging Face page)."@en ;
    rdfs:domain ffonto:Model ;
    rdfs:range xsd:anyURI .

ffonto:modelVersion a owl:DatatypeProperty ;
    rdfs:label "model version"@en ;
    rdfs:comment "Version of a model."@en ;
    rdfs:domain ffonto:Model ;
    rdfs:range xsd:string .

ffonto:near a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "near"@en ;
    rdfs:comment "Frame-relative proximity between two scene entities."@en ;
    rdfs:domain ffonto:SceneEntity ;
    rdfs:range ffonto:SceneEntity ;
    rdfs:subPropertyOf ffonto:spatiallyRelated .

ffonto:observationDate a owl:DatatypeProperty ;
    rdfs:label "observation date"@en ;
    rdfs:comment "Date of a weather/FWI record (stored as xsd:dateTime at 00:00 UTC)."@en ;
    rdfs:domain ffonto:WeatherRecord ;
    rdfs:range xsd:dateTime .

ffonto:onProperty a owl:ObjectProperty ;
    rdfs:label "on property"@en ;
    rdfs:comment "The weather/FWI datatype property the rule tests (e.g. ffonto:windSpeedKmh)."@en ;
    rdfs:domain ffonto:DangerRule .

ffonto:operator a owl:DatatypeProperty ;
    rdfs:label "operator"@en ;
    rdfs:comment "Comparison operator: \"gt\", \"ge\", \"lt\", \"le\"."@en ;
    rdfs:domain ffonto:DangerRule ;
    rdfs:range xsd:string .

ffonto:performs a owl:ObjectProperty ;
    rdfs:label "performs"@en ;
    rdfs:comment "Activity being carried out by an agent or vehicle (ffv:ActivityScheme)."@en ;
    rdfs:domain ffonto:SceneEntity ;
    rdfs:range skos:Concept .

ffonto:predictedClass a owl:ObjectProperty ;
    rdfs:label "predicted class"@en ;
    rdfs:comment "The class a classifier observation predicts (e.g. Fire, Smoke, Explosion)."@en ;
    rdfs:domain ffonto:ModelObservation ;
    rdfs:range skos:Concept .

ffonto:previousRecord a owl:ObjectProperty ;
    rdfs:label "previous record"@en ;
    rdfs:comment "DERIVED (rule R08): the closest earlier dated weather record of the same site; used for trends (CQ09)."@en ;
    rdfs:domain ffonto:WeatherRecord ;
    rdfs:range ffonto:WeatherRecord .

ffonto:protects a owl:ObjectProperty ;
    rdfs:label "protects"@en ;
    rdfs:comment "The subject (resource or crew) is protecting the object (e.g. a building)."@en ;
    rdfs:domain ffonto:SceneEntity ;
    rdfs:range ffonto:SceneEntity ;
    rdfs:subPropertyOf ffonto:spatiallyRelated .

ffonto:providesService a owl:ObjectProperty ;
    rdfs:label "provides ecosystem service"@en ;
    rdfs:comment "Ecosystem kind → ecosystem service it provides (and that fire may impair)."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept .

ffonto:reached a owl:ObjectProperty ;
    rdfs:label "reached"@en ;
    rdfs:comment "The subject (typically fire) has reached the object (e.g. a river edge or farmland)."@en ;
    rdfs:domain ffonto:SceneEntity ;
    rdfs:range ffonto:SceneEntity ;
    rdfs:subPropertyOf ffonto:spatiallyRelated .

ffonto:recordUUID a owl:DatatypeProperty ;
    rdfs:label "record UUID"@en ;
    rdfs:comment "Unique identifier of a record (record_uuid)."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range xsd:string .

ffonto:regionName a owl:DatatypeProperty ;
    rdfs:label "region name"@en ;
    rdfs:comment "Name of the region where the record was captured."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range xsd:string .

ffonto:relativePosition a owl:ObjectProperty ;
    rdfs:label "relative position"@en ;
    rdfs:comment "Frame-relative position with respect to the fire (ffv:PositionScheme: left flank, ahead of fire, ridge …)."@en ;
    rdfs:domain ffonto:SceneEntity ;
    rdfs:range skos:Concept .

ffonto:requiredPPE a owl:ObjectProperty ;
    rdfs:label "required PPE"@en ;
    rdfs:comment "Person kind → PPE item that person must wear (used by SHACL and CQ17)."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept .

ffonto:resolutionM a owl:DatatypeProperty ;
    rdfs:label "ground resolution (m)"@en ;
    rdfs:comment "Ground sampling distance of the image in metres."@en ;
    rdfs:domain ffonto:ImageRecord ;
    rdfs:range xsd:double .

ffonto:schemaVersion a owl:DatatypeProperty ;
    rdfs:label "schema version"@en ;
    rdfs:comment "Version of the record JSON schema."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range xsd:string .

ffonto:severity a owl:ObjectProperty ;
    rdfs:label "severity"@en ;
    rdfs:comment "Severity level assigned to an observation by the labelling pipeline."@en ;
    rdfs:domain ffonto:ModelObservation ;
    rdfs:range skos:Concept .

ffonto:siteName a owl:DatatypeProperty ;
    rdfs:label "site name"@en ;
    rdfs:comment "Name of a site."@en ;
    rdfs:domain ffonto:Site ;
    rdfs:range xsd:string .

ffonto:sourceName a owl:DatatypeProperty ;
    rdfs:label "source name"@en ;
    rdfs:comment "Name of the data source as recorded (e.g. unknown_camera)."@en ;
    rdfs:domain ffonto:DataRecord ;
    rdfs:range xsd:string .

ffonto:suggestedRestoration a owl:ObjectProperty ;
    rdfs:label "suggested restoration"@en ;
    rdfs:comment "Ecosystem kind → restoration or recovery measure suggested after fire."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept .

ffonto:threatens a owl:ObjectProperty ;
    rdfs:label "threatens"@en ;
    rdfs:comment "What the hazard endangers: a scene entity or a concept (e.g. ffv:Firefighter as a group)."@en ;
    rdfs:domain ffonto:Hazard .

ffonto:thresholdValue a owl:DatatypeProperty ;
    rdfs:label "threshold value"@en ;
    rdfs:comment "Numeric value of a threshold."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ffonto:Threshold ffonto:DangerRule ) ] ;
    rdfs:range xsd:double .

ffonto:topK a owl:DatatypeProperty ;
    rdfs:label "top-k"@en ;
    rdfs:comment "Number of top labels the model reports per frame."@en ;
    rdfs:domain ffonto:Model ;
    rdfs:range xsd:integer .

ffonto:topKLabel a owl:DatatypeProperty ;
    rdfs:label "top-k frame label"@en ;
    rdfs:comment "One of the top-k frame labels reported by the audio tagger."@en ;
    rdfs:domain ffonto:ModelObservation ;
    rdfs:range xsd:string .

ffonto:typicalFireImpact a owl:ObjectProperty ;
    rdfs:label "typical fire impact"@en ;
    rdfs:comment "Ecosystem / vegetation kind → typical ecological impact of fire."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept .

ffonto:usedThreshold a owl:ObjectProperty ;
    rdfs:label "used threshold"@en ;
    rdfs:comment "The decision threshold that applies to the observation's predicted class."@en ;
    rdfs:domain ffonto:ModelObservation ;
    rdfs:range ffonto:Threshold .

ffonto:wears a owl:ObjectProperty ;
    rdfs:label "wears"@en ;
    rdfs:comment "Protective equipment worn by a person (ffv:PPEScheme)."@en ;
    rdfs:domain ffonto:Agent ;
    rdfs:range skos:Concept .

ffonto:widthPx a owl:DatatypeProperty ;
    rdfs:label "width (px)"@en ;
    rdfs:comment "Image width in pixels."@en ;
    rdfs:domain ffonto:ImageRecord ;
    rdfs:range xsd:integer .

<http://purl.org/ffonto/data/event/ev-demo-081/conflict/AudioImageConflict/6ada4bc88defafc432eb856e993ab54c> a ffonto:ModalityConflict ;
    ffonto:conflictType ffv:AudioImageConflict ;
    ffonto:inEvent <http://purl.org/ffonto/data/event/ev-demo-081> ;

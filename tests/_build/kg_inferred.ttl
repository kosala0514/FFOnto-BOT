    skos:inScheme ffv:ValueScheme ;
    skos:prefLabel "Direction"@en ;
    skos:topConceptOf ffv:ValueScheme .

ffv:EcosystemService a skos:Concept ;
    rdfs:label "Ecosystem service"@en ;
    skos:inScheme ffv:EcologyScheme ;
    skos:prefLabel "Ecosystem service"@en ;
    skos:topConceptOf ffv:EcologyScheme .

ffv:Explosion a skos:Concept ;
    rdfs:label "Explosion"@en ;
    skos:broader ffv:FireSound ;
    skos:hiddenLabel "boom"@en,
        "burst"@en,
        "explosion"@en ;
    skos:inScheme ffv:SoundEventScheme ;
    skos:prefLabel "Explosion"@en .

ffv:Fire a skos:Concept ;
    rdfs:label "Fire"@en ;
    skos:hiddenLabel "blaze"@en,
        "burning"@en,
        "fire"@en,
        "flame"@en,
        "flames"@en ;
    skos:inScheme ffv:DetectionClassScheme ;
    skos:prefLabel "Fire"@en ;
    skos:topConceptOf ffv:DetectionClassScheme .

ffv:Person a skos:Concept ;
    rdfs:label "Person"@en ;
    skos:broader ffv:AgentKind ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Person"@en .

ffv:Smoke a skos:Concept ;
    rdfs:label "Smoke"@en ;
    skos:hiddenLabel "haze"@en,
        "smoke"@en,
        "smoky"@en ;
    skos:inScheme ffv:DetectionClassScheme ;
    skos:prefLabel "Smoke"@en ;
    skos:topConceptOf ffv:DetectionClassScheme .

ffv:Terrain a skos:Concept ;
    rdfs:label "Terrain"@en ;
    skos:broader ffv:EnvironmentFeatureKind ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Terrain"@en .

ffv:WaterBody a skos:Concept ;
    rdfs:label "Water body"@en ;
    ffonto:providesService ffv:WaterRegulation ;
    ffonto:suggestedRestoration ffv:RiparianRestoration ;
    ffonto:typicalFireImpact ffv:WaterQualityDegradation ;
    skos:broader ffv:EnvironmentFeatureKind ;
    skos:hiddenLabel "water"@en ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Water body"@en .

ffonto:Site a owl:Class ;
    rdfs:label "Site"@en ;
    rdfs:comment "A named place or grid cell where data were recorded (weather station, camera site, grid cell)."@en ;
    rdfs:subClassOf sosa:FeatureOfInterest .

ffv:DamageState a skos:Concept ;
    rdfs:label "Damage state"@en ;
    skos:inScheme ffv:StateScheme ;
    skos:prefLabel "Damage state"@en ;
    skos:topConceptOf ffv:StateScheme .

ffv:EnvironmentFeatureKind a skos:Concept ;
    rdfs:label "Environment feature (kind)"@en ;
    rdfs:seeAlso ffonto:EnvironmentFeature ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Environment feature (kind)"@en ;
    skos:topConceptOf ffv:EntityKindScheme .

ffv:OperationalState a skos:Concept ;
    rdfs:label "Operational state"@en ;
    skos:inScheme ffv:StateScheme ;
    skos:prefLabel "Operational state"@en ;
    skos:topConceptOf ffv:StateScheme .

ffv:RestorationMeasure a skos:Concept ;
    rdfs:label "Restoration measure"@en ;
    skos:inScheme ffv:EcologyScheme ;
    skos:prefLabel "Restoration measure"@en ;
    skos:topConceptOf ffv:EcologyScheme .

ffv:SuppressionActivity a skos:Concept ;
    rdfs:label "Suppression activity"@en ;
    skos:inScheme ffv:ActivityScheme ;
    skos:prefLabel "Suppression activity"@en ;
    skos:topConceptOf ffv:ActivityScheme .

ffv:Vegetation a skos:Concept ;
    rdfs:label "Vegetation"@en ;
    skos:broader ffv:EnvironmentFeatureKind ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Vegetation"@en .

prov:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "A physical, digital or conceptual thing with some fixed aspects (PROV-O)."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

ffv:Colour a skos:Concept ;
    rdfs:label "Colour"@en ;
    skos:inScheme ffv:ValueScheme ;
    skos:prefLabel "Colour"@en ;
    skos:topConceptOf ffv:ValueScheme .

<http://purl.org/ffonto/data/scene/scene-fixture-081/e5> a ffonto:FirePhenomenon ;
    ffonto:advancingToward <http://purl.org/ffonto/data/scene/scene-fixture-081/e4> ;
    ffonto:count 2 ;
    ffonto:hasKind ffv:FlameFront .

ffv:GroundVehicle a skos:Concept ;
    rdfs:label "Ground vehicle"@en ;
    skos:broader ffv:VehicleKind ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Ground vehicle"@en .

ffv:VegetationState a skos:Concept ;
    rdfs:label "Vegetation state"@en ;
    skos:inScheme ffv:StateScheme ;
    skos:prefLabel "Vegetation state"@en ;
    skos:topConceptOf ffv:StateScheme .

ffonto:ImageRecord a owl:Class ;
    rdfs:label "Image record"@en ;
    rdfs:comment "A still image or video frame record with its file, quality and geo metadata."@en ;
    rdfs:subClassOf ffonto:DataRecord ;
    owl:disjointWith ffonto:AudioRecord,
        ffonto:WeatherRecord .

ffonto:Model a owl:Class ;
    rdfs:label "Model"@en ;
    rdfs:comment "A machine-learning model (classifier, captioner, audio tagger, vision-language model) that produces observations, captions or scene descriptions."@en ;
    rdfs:subClassOf prov:SoftwareAgent,
        sosa:Sensor .

ffonto:Threshold a owl:Class ;
    rdfs:label "Threshold"@en ;
    rdfs:comment "A configured decision threshold for one class (e.g. fire_threshold = 0.55)."@en ;
    rdfs:subClassOf prov:Entity .

ffv:EcologicalImpact a skos:Concept ;
    rdfs:label "Ecological impact"@en ;
    skos:inScheme ffv:EcologyScheme ;
    skos:prefLabel "Ecological impact"@en ;
    skos:topConceptOf ffv:EcologyScheme .

ffv:ResponseActivity a skos:Concept ;
    rdfs:label "Response activity"@en ;
    skos:inScheme ffv:ActivityScheme ;
    skos:prefLabel "Response activity"@en ;
    skos:topConceptOf ffv:ActivityScheme .


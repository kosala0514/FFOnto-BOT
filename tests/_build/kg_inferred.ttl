<http://purl.org/ffonto/data/record/weather/demo-site-a/grid-2-2/2012-08-28> a ffonto:WeatherRecord ;
    ffonto:aboutEvent <http://purl.org/ffonto/data/event/ev-demo-081> ;
    ffonto:airTemperatureC 1.74e+01 ;
    ffonto:atSite <http://purl.org/ffonto/data/site/demo-site-a/grid-2-2> ;
    ffonto:bui 1.504e+02 ;
    ffonto:burnedAreaHa 1.07e+00 ;
    ffonto:dayName "tue" ;
    ffonto:dc 6.471e+02 ;
    ffonto:dmc 1.083e+02 ;
    ffonto:ffmc 9.48e+01 ;
    ffonto:fireOccurred true ;
    ffonto:fwi 3.31e+01 ;
    ffonto:hasCondition ffontov:ElevatedFireDanger,
        ffontov:FavourDirectAttack,
        ffontov:PersistentCombustion,
        ffontov:RapidFineFuelSpread ;
    ffonto:isi 1.7e+01 ;
    ffonto:observationDate "2012-08-28T00:00:00+00:00"^^xsd:dateTime ;
    ffonto:previousRecord <http://purl.org/ffonto/data/record/weather/demo-site-a/grid-2-2/2012-08-27> ;
    ffonto:rainMm 0e+00 ;
    ffonto:relativeHumidityPct 4.3e+01 ;
    ffonto:sourceName "weather_csv" ;
    ffonto:windSpeedKmh 6.7e+00 .

ffr:dc-persistent a ffonto:DangerRule ;
    rdfs:label "High Drought Code indicates deep, persistent smouldering"@en ;
    ffonto:indicatesCondition ffontov:PersistentCombustion ;
    ffonto:onProperty ffonto:dc ;
    ffonto:operator "ge" ;
    ffonto:thresholdValue 4e+02 ;
    rdfs:comment "PLACEHOLDER threshold."@en .

ffr:ffmc-spread a ffonto:DangerRule ;
    rdfs:label "High FFMC indicates easily ignited fine fuels"@en ;
    ffonto:indicatesCondition ffontov:RapidFineFuelSpread ;
    ffonto:onProperty ffonto:ffmc ;
    ffonto:operator "ge" ;
    ffonto:thresholdValue 9e+01 ;
    rdfs:comment "PLACEHOLDER threshold."@en .

ffr:fwi-danger a ffonto:DangerRule ;
    rdfs:label "High FWI indicates elevated fire danger"@en ;
    ffonto:indicatesCondition ffontov:ElevatedFireDanger ;
    ffonto:onProperty ffonto:fwi ;
    ffonto:operator "ge" ;
    ffonto:thresholdValue 3e+01 ;
    rdfs:comment "PLACEHOLDER threshold."@en .

ffr:isi-spread a ffonto:DangerRule ;
    rdfs:label "High ISI indicates rapid fine-fuel spread"@en ;
    ffonto:indicatesCondition ffontov:RapidFineFuelSpread ;
    ffonto:onProperty ffonto:isi ;
    ffonto:operator "gt" ;
    ffonto:thresholdValue 1e+01 ;
    rdfs:comment "PLACEHOLDER threshold."@en .

ffr:rain-mopup a ffonto:DangerRule ;
    rdfs:label "Rain improves mop-up conditions"@en ;
    ffonto:indicatesCondition ffontov:ImprovedMopUpConditions ;
    ffonto:onProperty ffonto:rainMm ;
    ffonto:operator "gt" ;
    ffonto:thresholdValue 2e+00 ;
    rdfs:comment "PLACEHOLDER threshold."@en .

ffr:rh-direct a ffonto:DangerRule ;
    rdfs:label "Moderate/high RH favours direct attack with hand tools"@en ;
    ffonto:indicatesCondition ffontov:FavourDirectAttack ;
    ffonto:onProperty ffonto:relativeHumidityPct ;
    ffonto:operator "ge" ;
    ffonto:thresholdValue 4e+01 ;
    rdfs:comment "PLACEHOLDER threshold."@en .

ffr:rh-drying a ffonto:DangerRule ;
    rdfs:label "Low RH favours rapid fine-fuel drying"@en ;
    ffonto:indicatesCondition ffontov:RapidFineFuelDrying ;
    ffonto:onProperty ffonto:relativeHumidityPct ;
    ffonto:operator "lt" ;
    ffonto:thresholdValue 3e+01 ;
    rdfs:comment "PLACEHOLDER threshold."@en .

ffr:temp-heat a ffonto:DangerRule ;
    rdfs:label "High temperature indicates heat-stress risk"@en ;
    ffonto:indicatesCondition ffontov:HeatStressRisk ;
    ffonto:onProperty ffonto:airTemperatureC ;
    ffonto:operator "ge" ;
    ffonto:thresholdValue 3.2e+01 ;
    rdfs:comment "PLACEHOLDER threshold."@en .

ffr:wind-aerial a ffonto:DangerRule ;
    rdfs:label "Strong wind reduces aerial-drop effectiveness"@en ;
    ffonto:indicatesCondition ffontov:AerialDropCompromised ;
    ffonto:onProperty ffonto:windSpeedKmh ;
    ffonto:operator "gt" ;
    ffonto:thresholdValue 3e+01 ;
    rdfs:comment "PLACEHOLDER threshold."@en .


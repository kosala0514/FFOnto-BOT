<http://purl.org/ffonto/rules> a owl:Ontology ;
    dcterms:creator "Charuni Kosala Jayaweera" ;
    dcterms:description "Threshold rules over weather and Fire Weather Index properties, stored as individuals of ffonto:DangerRule."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "FFOnto weather / FWI danger rules"@en ;
    owl:versionInfo "2.0.0" .

<http://purl.org/ffonto/vocab> a owl:Ontology ;
    dcterms:creator "Charuni Kosala Jayaweera" ;
    dcterms:description "SKOS concept schemes for FFOnto: entity kinds, states, activities, PPE, observable properties, values, hazards, actions, conditions and ecological background knowledge."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "FFOnto controlled vocabulary"@en ;
    rdfs:comment "Load together with ffonto-core.ttl (see ffonto.ttl and catalog-v001.xml)."@en ;
    owl:versionInfo "2.0.0" .

ffv:Accessible a skos:Concept ;
    rdfs:label "Accessible"@en ;
    skos:broader ffv:AccessState ;
    skos:inScheme ffv:StateScheme ;
    skos:prefLabel "Accessible"@en .

ffv:ActingAsLookout a skos:Concept ;
    rdfs:label "Acting as lookout"@en ;
    skos:broader ffv:ResponseActivity ;
    skos:inScheme ffv:ActivityScheme ;
    skos:prefLabel "Acting as lookout"@en .

ffv:AerialReconnaissance a skos:Concept ;
    rdfs:label "Aerial reconnaissance"@en ;
    skos:broader ffv:AerialSuppression ;
    skos:inScheme ffv:ActivityScheme ;
    skos:prefLabel "Aerial reconnaissance"@en .

ffv:AgriculturalLand a skos:Concept ;
    rdfs:label "Agricultural land"@en ;
    skos:broader ffv:EnvironmentFeatureKind ;
    skos:hiddenLabel "crop"@en,
        "farm"@en,
        "farmland"@en,
        "orchard"@en ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Agricultural land"@en .

ffv:AirPollution a skos:Concept ;
    rdfs:label "Air pollution"@en ;
    skos:broader ffv:EcologicalImpact ;
    skos:inScheme ffv:EcologyScheme ;
    skos:prefLabel "Air pollution"@en .

ffv:AirQualityLevel a skos:Concept ;
    rdfs:label "Air quality level"@en ;
    skos:inScheme ffv:ObservablePropertyScheme ;
    skos:prefLabel "Air quality level"@en ;
    skos:topConceptOf ffv:ObservablePropertyScheme .

ffv:AirTanker a skos:Concept ;
    rdfs:label "Air tanker"@en ;
    skos:broader ffv:Aircraft ;
    skos:hiddenLabel "air tanker"@en,
        "airtanker"@en,
        "water bomber"@en ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Air tanker"@en .

ffv:Ambulance a skos:Concept ;
    rdfs:label "Ambulance"@en ;
    skos:broader ffv:GroundVehicle ;
    skos:hiddenLabel "ambulance"@en ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Ambulance"@en .

ffv:AshColour a skos:Concept ;
    rdfs:label "Ash colour"@en ;
    skos:inScheme ffv:ObservablePropertyScheme ;
    skos:prefLabel "Ash colour"@en ;
    skos:topConceptOf ffv:ObservablePropertyScheme .

ffv:AshDeposit a skos:Concept ;
    rdfs:label "Ash deposit"@en ;
    skos:broader ffv:BurnEvidenceKind ;
    skos:hiddenLabel "ash"@en ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Ash deposit"@en .

ffv:AssistingCivilian a skos:Concept ;
    rdfs:label "Assisting civilian"@en ;
    skos:broader ffv:ResponseActivity ;
    skos:inScheme ffv:ActivityScheme ;
    skos:prefLabel "Assisting civilian"@en .

ffv:AssistingVulnerablePerson a skos:Concept ;
    rdfs:label "Assisting children / elderly"@en ;
    skos:broader ffv:CivilianActivity ;
    skos:inScheme ffv:ActivityScheme ;
    skos:prefLabel "Assisting children / elderly"@en .

ffv:Axe a skos:Concept ;
    rdfs:label "Axe"@en ;
    skos:broader ffv:HandTool ;
    skos:hiddenLabel "axe"@en ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Axe"@en .

ffv:BareGround a skos:Concept ;
    rdfs:label "Bare ground"@en ;
    skos:broader ffv:EnvironmentFeatureKind ;
    skos:hiddenLabel "bare"@en,
        "barren"@en ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Bare ground"@en .

ffv:Barn a skos:Concept ;
    rdfs:label "Barn"@en ;
    skos:broader ffv:Building ;
    skos:hiddenLabel "barn"@en ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Barn"@en .

ffv:Barricade a skos:Concept ;
    rdfs:label "Barricade"@en ;
    skos:broader ffv:TrafficControlDevice ;
    skos:hiddenLabel "barricade"@en,
        "road closure sign"@en ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Barricade"@en .

ffv:BeatingOutFlames a skos:Concept ;
    rdfs:label "Beating out flames"@en ;
    skos:broader ffv:DirectAttack ;
    skos:inScheme ffv:ActivityScheme ;
    skos:prefLabel "Beating out flames"@en .

ffv:Black a skos:Concept ;
    rdfs:label "Black"@en ;
    skos:broader ffv:Colour ;
    skos:inScheme ffv:ValueScheme ;
    skos:prefLabel "Black"@en .

ffv:Blocked a skos:Concept ;
    rdfs:label "Blocked"@en ;
    skos:broader ffv:AccessState ;
    skos:inScheme ffv:StateScheme ;
    skos:prefLabel "Blocked"@en .

ffv:Blue a skos:Concept ;
    rdfs:label "Blue"@en ;
    skos:broader ffv:Colour ;
    skos:inScheme ffv:ValueScheme ;
    skos:prefLabel "Blue"@en .

ffv:Bridge a skos:Concept ;
    rdfs:label "Bridge"@en ;
    skos:broader ffv:BuiltAssetKind ;
    skos:hiddenLabel "bridge"@en ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Bridge"@en .

ffv:Briefing a skos:Concept ;
    rdfs:label "Briefing"@en ;
    skos:broader ffv:ResponseActivity ;
    skos:inScheme ffv:ActivityScheme ;

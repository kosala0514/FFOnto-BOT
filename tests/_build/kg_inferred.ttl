<http://purl.org/ffonto/rules> a owl:Ontology ;
    rdfs:label "FFOnto danger rules"@en ;
    dcterms:abstract "Weather and Fire Weather Index (FWI) threshold rules stored as data (individuals of ffonto:DangerRule), so thresholds can be changed and cited without editing queries. The current threshold values are PLACEHOLDERS for testing."@en ;
    dcterms:creator "Charuni Kosala Jayaweera" ;
    dcterms:description "Threshold rules over weather and Fire Weather Index properties, stored as individuals of ffonto:DangerRule."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "FFOnto weather / FWI danger rules"@en ;
    vann:preferredNamespacePrefix "ffr" ;
    vann:preferredNamespaceUri "http://purl.org/ffonto/data/rule/" ;
    owl:versionIRI <http://purl.org/ffonto/rules/2.0.0> ;
    owl:versionInfo "2.0.0" .

<http://purl.org/ffonto/vocab> a owl:Ontology ;
    rdfs:label "FFOnto vocabulary"@en ;
    dcterms:abstract "SKOS controlled vocabulary of FFOnto: the fine-grained kinds and values used in forest-fire knowledge graphs (detection classes, sound events, scene entity kinds, states, activities, PPE, positions, observable properties, values, hazards, actions, weather conditions, modality conflicts and ecological background knowledge). New kinds are added here as concepts under skos:broader, without changing the core schema."@en ;
    dcterms:contributor "Prof. Dulani Meedeniya" ;
    dcterms:created "2026-10-07"^^xsd:date ;
    dcterms:creator "Charuni Kosala Jayaweera" ;
    dcterms:description "SKOS concept schemes for FFOnto: entity kinds, states, activities, PPE, observable properties, values, hazards, actions, conditions and ecological background knowledge. skos:hiddenLabel holds the keywords used for caption tagging and for the scene-extraction prompt. Load together with ffonto-core.ttl (see ffonto.ttl and catalog-v001.xml)."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    dcterms:title "FFOnto controlled vocabulary"@en ;
    vann:preferredNamespacePrefix "ffontov" ;
    vann:preferredNamespaceUri "http://purl.org/ffonto/vocab#" ;
    owl:versionIRI <http://purl.org/ffonto/vocab/2.0.0> ;
    owl:versionInfo "2.0.0" .

ffontov:Accessible a skos:Concept ;
    rdfs:label "Accessible"@en ;
    skos:broader ffontov:AccessState ;
    skos:inScheme ffontov:StateScheme ;
    skos:prefLabel "Accessible"@en .

ffontov:ActingAsLookout a skos:Concept ;
    rdfs:label "Acting as lookout"@en ;
    skos:broader ffontov:ResponseActivity ;
    skos:inScheme ffontov:ActivityScheme ;
    skos:prefLabel "Acting as lookout"@en .

ffontov:AerialReconnaissance a skos:Concept ;
    rdfs:label "Aerial reconnaissance"@en ;
    skos:broader ffontov:AerialSuppression ;
    skos:inScheme ffontov:ActivityScheme ;
    skos:prefLabel "Aerial reconnaissance"@en .

ffontov:AgriculturalLand a skos:Concept ;
    rdfs:label "Agricultural land"@en ;
    skos:broader ffontov:EnvironmentFeatureKind ;
    skos:hiddenLabel "crop"@en,
        "farm"@en,
        "farmland"@en,
        "orchard"@en ;
    skos:inScheme ffontov:EntityKindScheme ;
    skos:prefLabel "Agricultural land"@en .

ffontov:AirPollution a skos:Concept ;
    rdfs:label "Air pollution"@en ;
    skos:broader ffontov:EcologicalImpact ;
    skos:inScheme ffontov:EcologyScheme ;
    skos:prefLabel "Air pollution"@en .

ffontov:AirQualityLevel a skos:Concept ;
    rdfs:label "Air quality level"@en ;
    skos:inScheme ffontov:ObservablePropertyScheme ;
    skos:prefLabel "Air quality level"@en ;
    skos:topConceptOf ffontov:ObservablePropertyScheme .

ffontov:AirTanker a skos:Concept ;
    rdfs:label "Air tanker"@en ;
    skos:broader ffontov:Aircraft ;
    skos:hiddenLabel "air tanker"@en,
        "airtanker"@en,
        "water bomber"@en ;
    skos:inScheme ffontov:EntityKindScheme ;
    skos:prefLabel "Air tanker"@en .

ffontov:Ambulance a skos:Concept ;
    rdfs:label "Ambulance"@en ;
    skos:broader ffontov:GroundVehicle ;
    skos:hiddenLabel "ambulance"@en ;
    skos:inScheme ffontov:EntityKindScheme ;
    skos:prefLabel "Ambulance"@en .

ffontov:AshColour a skos:Concept ;
    rdfs:label "Ash colour"@en ;
    skos:inScheme ffontov:ObservablePropertyScheme ;
    skos:prefLabel "Ash colour"@en ;
    skos:topConceptOf ffontov:ObservablePropertyScheme .

ffontov:AshDeposit a skos:Concept ;
    rdfs:label "Ash deposit"@en ;
    skos:broader ffontov:BurnEvidenceKind ;
    skos:hiddenLabel "ash"@en ;
    skos:inScheme ffontov:EntityKindScheme ;
    skos:prefLabel "Ash deposit"@en .

ffontov:AssistingCivilian a skos:Concept ;
    rdfs:label "Assisting civilian"@en ;
    skos:broader ffontov:ResponseActivity ;
    skos:inScheme ffontov:ActivityScheme ;
    skos:prefLabel "Assisting civilian"@en .

ffontov:AssistingVulnerablePerson a skos:Concept ;
    rdfs:label "Assisting children / elderly"@en ;
    skos:broader ffontov:CivilianActivity ;
    skos:inScheme ffontov:ActivityScheme ;
    skos:prefLabel "Assisting children / elderly"@en .

ffontov:Axe a skos:Concept ;

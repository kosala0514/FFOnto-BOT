ffv:BurnEvidenceKind a skos:Concept ;
    rdfs:label "Burn evidence (kind)"@en ;
    rdfs:seeAlso ffonto:BurnEvidence ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Burn evidence (kind)"@en ;
    skos:topConceptOf ffv:EntityKindScheme .

ffv:FirePhenomenonKind a skos:Concept ;
    rdfs:label "Fire phenomenon (kind)"@en ;
    rdfs:seeAlso ffonto:FirePhenomenon ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Fire phenomenon (kind)"@en ;
    skos:topConceptOf ffv:EntityKindScheme .

ffv:LabelSourceScheme a skos:ConceptScheme ;
    rdfs:label "Label sources (scheme)"@en ;
    skos:definition "Where a label came from."@en ;
    skos:prefLabel "Label sources"@en .

ffv:SoundEventScheme a skos:ConceptScheme ;
    rdfs:label "Sound events (scheme)"@en ;
    skos:definition "Audio event classes (aligned with AudioSet/YAMNet labels where possible)."@en ;
    skos:prefLabel "Sound events"@en .

ffonto:DangerRule a owl:Class ;
    rdfs:label "Danger rule"@en ;
    rdfs:comment "A threshold rule over a weather/FWI property (property, operator, value) that indicates an operational condition. Stored as data so experts can edit it."@en ;
    rdfs:subClassOf prov:Entity .

ffv:BuiltAssetKind a skos:Concept ;
    rdfs:label "Built asset (kind)"@en ;
    rdfs:seeAlso ffonto:BuiltAsset ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Built asset (kind)"@en ;
    skos:topConceptOf ffv:EntityKindScheme .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept scheme"@en ;
    rdfs:comment "A set of concepts forming one controlled vocabulary (SKOS)."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

ffv:ConditionScheme a skos:ConceptScheme ;
    rdfs:label "Operational conditions (scheme)"@en ;
    skos:definition "Conditions implied by weather/FWI danger rules."@en ;
    skos:prefLabel "Operational conditions"@en .

ffv:EquipmentKind a skos:Concept ;
    rdfs:label "Equipment (kind)"@en ;
    rdfs:seeAlso ffonto:Equipment ;
    skos:inScheme ffv:EntityKindScheme ;
    skos:prefLabel "Equipment (kind)"@en ;
    skos:topConceptOf ffv:EntityKindScheme .

ffv:VLMSource a skos:Concept ;
    rdfs:label "Vision-language model"@en ;
    skos:hiddenLabel "vlm"@en ;
    skos:inScheme ffv:LabelSourceScheme ;
    skos:prefLabel "Vision-language model"@en ;
    skos:topConceptOf ffv:LabelSourceScheme .

ffonto:Hazard a owl:Class ;
    rdfs:label "Hazard"@en ;
    rdfs:comment "A risk DERIVED by a rule from observations; typed by ffonto:hasHazardType → ffv:HazardScheme concept and linked to what it threatens."@en ;
    rdfs:subClassOf prov:Entity .

<http://purl.org/ffonto/data/event/ev-demo-081> a ffonto:FireEvent ;
    ffonto:eventCode "ev_demo_081" .

<http://purl.org/ffonto/data/model/example-vlm-hand-written-fixture-replace-with-real-vlm-output/0> a ffonto:Model ;
    ffonto:modelName "EXAMPLE-VLM (hand-written fixture, replace with real VLM output)" ;
    ffonto:modelVersion "0" .

ffv:PositionScheme a skos:ConceptScheme ;
    rdfs:label "Frame-relative positions (scheme)"@en ;
    skos:definition "Position of an entity relative to the fire in the frame."@en ;
    skos:prefLabel "Frame-relative positions"@en .

ffv:PPEScheme a skos:ConceptScheme ;
    rdfs:label "Personal protective equipment (scheme)"@en ;
    skos:definition "Items a person can be seen wearing."@en ;
    skos:prefLabel "Personal protective equipment"@en .

ffonto:DataRecord a owl:Class ;
    rdfs:label "Data record"@en ;
    rdfs:comment "One captured data item (an image, an audio clip, a weather row) together with its metadata."@en ;
    rdfs:subClassOf prov:Entity .

ffonto:WeatherRecord a owl:Class ;
    rdfs:label "Weather / FWI record"@en ;
    rdfs:comment "One row of the tabular weather and Fire Weather Index dataset."@en ;
    rdfs:subClassOf ffonto:DataRecord .

ffonto:SceneEntity a owl:Class ;
    rdfs:label "Scene entity"@en ;
    rdfs:comment "Something depicted in an image according to a scene description (a fire front, a firefighter, a building …). Its fine-grained kind is given by ffonto:hasKind → a concept in ffv:EntityKindScheme."@en ;
    rdfs:subClassOf sosa:FeatureOfInterest .

ffv:HazardScheme a skos:ConceptScheme ;
    rdfs:label "Hazard types (scheme)"@en ;
    skos:definition "Types of hazards derived by rules."@en ;
    skos:prefLabel "Hazard types"@en .

ffv:EcologyScheme a skos:ConceptScheme ;
    rdfs:label "Ecological impacts, services and restoration (scheme)"@en ;
    skos:definition "Background ecological knowledge for CQ26."@en ;
    skos:prefLabel "Ecological impacts, services and restoration"@en .

ffv:ActionScheme a skos:ConceptScheme ;
    rdfs:label "Recommended actions (scheme)"@en ;
    skos:definition "Protective / operational actions recommended for hazards."@en ;
    skos:prefLabel "Recommended actions"@en .

ffonto:ModelObservation a owl:Class ;
    rdfs:label "Model observation"@en ;
    rdfs:comment "A claim made by a model about a data record: either a predicted class with a confidence (ffonto:predictedClass) or a categorical value for an observable property (sosa:observedProperty + ffonto:hasValueConcept)."@en ;
    rdfs:subClassOf sosa:Observation .

ffv:ActivityScheme a skos:ConceptScheme ;
    rdfs:label "Activities (scheme)"@en ;
    skos:definition "What agents or vehicles are doing."@en ;
    skos:prefLabel "Activities"@en .

ffv:ObservablePropertyScheme a skos:ConceptScheme ;
    rdfs:label "Observable scene properties (scheme)"@en ;
    skos:definition "Scene-level properties a model can report a categorical value for."@en ;
    skos:prefLabel "Observable scene properties"@en .

ffv:StateScheme a skos:ConceptScheme ;
    rdfs:label "Entity states (scheme)"@en ;
    skos:definition "States / conditions of scene entities."@en ;
    skos:prefLabel "Entity states"@en .

ffv:ValueScheme a skos:ConceptScheme ;
    rdfs:label "Categorical values (scheme)"@en ;
    skos:definition "Shared value concepts used as observation results."@en ;
    skos:prefLabel "Categorical values"@en .

ffv:EntityKindScheme a skos:ConceptScheme ;
    rdfs:label "Scene entity kinds (scheme)"@en ;
    skos:definition "Fine-grained kinds of things that can be depicted in a fire scene. The top concepts correspond to the core classes."@en ;
    skos:prefLabel "Scene entity kinds"@en .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "A unit of thought in a controlled vocabulary (SKOS)."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

[] a owl:AllDisjointClasses ;
    owl:members ( ffonto:FirePhenomenon ffonto:Agent ffonto:Equipment ffonto:Vehicle ffonto:BuiltAsset ffonto:EnvironmentFeature ffonto:BurnEvidence ) .


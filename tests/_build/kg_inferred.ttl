ffonto:SceneEntity a owl:Class ;
    rdfs:label "Scene entity"@en ;
    rdfs:comment "Something depicted in an image according to a scene description (a fire front, a firefighter, a building …). Its fine-grained kind is given by ffonto:hasKind → a concept in ffontov:EntityKindScheme."@en ;
    rdfs:subClassOf sosa:FeatureOfInterest .

ffontov:HazardScheme a skos:ConceptScheme ;
    rdfs:label "Hazard types (scheme)"@en ;
    skos:definition "Types of hazards derived by rules."@en ;
    skos:prefLabel "Hazard types"@en .

ffontov:EcologyScheme a skos:ConceptScheme ;

@prefix ffonto:     <http://purl.org/ffonto#> .
@prefix ffontov:     <http://purl.org/ffonto/vocab#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .

# =====================================================================
#  FFOnto v2 — CORE SCHEMA
#  Scope: answer the ForestFire-VQA competency questions CQ01–CQ26
#  over multimodal records (image, audio, weather/FWI tabular).
#
#  Design rules
#   1. Three layers are kept apart:
#        WORLD   (FireEvent, SceneEntity)
#        DATA    (DataRecord and its subclasses)
#        CLAIM   (ModelObservation: what a model says, with confidence)
#   2. Fine-grained kinds/values (Pulaski, Helmet, Gray, Scorched …) are
#      SKOS concepts in ffonto-vocab.ttl, NOT classes or properties.
#   3. Risk/decision knowledge is DERIVED by rules (rules/*.rq), not stored.
#   4. Reuse SOSA/SSN, PROV-O, SKOS, Dublin Core instead of re-inventing.
#   5. Definitions are rdfs:comment (OWL/OOPS!/ROBOT friendly).
# =====================================================================

<http://purl.org/ffonto>
    a owl:Ontology ;
    rdfs:label "FFOnto"@en ;
    owl:versionIRI <http://purl.org/ffonto/2.0.0> ;
    owl:versionInfo "2.0.0" ;
    dcterms:title "Forest Fire Ontology (FFOnto) – core"@en ;
    dcterms:abstract "FFOnto is a competency-question-driven ontology for building multimodal forest-fire knowledge graphs from images, audio clips and weather / Fire Weather Index (FWI) records. It separates the world (fire events and scene entities), the data (records and their metadata) and the claims made about the data by machine-learning models (observations with confidence, threshold and provenance), so that model outputs are never stored as facts. Fine-grained kinds and values are kept in a SKOS vocabulary, and risk knowledge (detections, conditions, cross-modal conflicts, hazards) is derived by rules."@en ;
    dcterms:description "Minimal, competency-question-driven ontology for multimodal (image, audio, tabular) forest-fire knowledge graphs, aligned with the ForestFire-VQA dataset. SOSA, PROV-O, SKOS and Dublin Core terms are reused by IRI and declared locally (no owl:imports), so the ontology loads offline and stays in OWL 2 DL."@en ;
    dcterms:creator "Charuni Kosala Jayaweera" ;
    dcterms:contributor "Prof. Dulani Meedeniya" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-10-07"^^xsd:date ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    bibo:status "Draft"@en ;
    dcterms:bibliographicCitation "Jayaweera, C. K. and Meedeniya, D. (2026). FFOnto: Forest Fire Ontology, version 2.0.0. http://purl.org/ffonto"@en ;
    vann:preferredNamespacePrefix "ffonto" ;
    vann:preferredNamespaceUri "http://purl.org/ffonto#" .

# ---------------------------------------------------------------------
#  REUSED EXTERNAL TERMS (declared here so reasoners and ROBOT know their type)
# ---------------------------------------------------------------------
sosa:Observation        a owl:Class ; rdfs:label "Observation"@en ;        rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
    rdfs:comment "An act of estimating or calculating the value of a property of a feature of interest (SOSA)."@en .
sosa:Sensor             a owl:Class ; rdfs:label "Sensor"@en ;             rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
    rdfs:comment "A device, agent or software that observes (SOSA)."@en .
sosa:FeatureOfInterest  a owl:Class ; rdfs:label "Feature of interest"@en ; rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
    rdfs:comment "The thing whose property is being estimated or calculated by an observation (SOSA)."@en .
sosa:hasFeatureOfInterest a owl:ObjectProperty ; rdfs:label "has feature of interest"@en ; rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
    rdfs:comment "Relates an observation to the entity whose property was observed (SOSA)."@en .
sosa:observedProperty   a owl:ObjectProperty ; rdfs:label "observed property"@en ; rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
    rdfs:comment "Relates an observation to the property that was observed (SOSA)."@en .
prov:Entity             a owl:Class ; rdfs:label "Entity"@en ;             rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:comment "A physical, digital or conceptual thing with some fixed aspects (PROV-O)."@en .
prov:Agent              a owl:Class ; rdfs:label "Agent (PROV)"@en ;       rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:comment "Something that bears responsibility for an activity, an entity or another agent (PROV-O)."@en .
prov:SoftwareAgent      a owl:Class ; rdfs:label "Software agent"@en ;     rdfs:subClassOf prov:Agent ; rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:comment "Running software that is responsible for something (PROV-O)."@en .
prov:wasAttributedTo    a owl:ObjectProperty ; rdfs:label "was attributed to"@en ; rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:comment "Ascribes an entity to the agent responsible for it (PROV-O)."@en .
prov:wasDerivedFrom     a owl:ObjectProperty ; rdfs:label "was derived from"@en ;  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:comment "States that an entity was transformed from, or constructed from, another entity (PROV-O)."@en .
skos:Concept            a owl:Class ; rdfs:label "Concept"@en ;            rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:comment "A unit of thought in a controlled vocabulary (SKOS)."@en .
skos:ConceptScheme      a owl:Class ; rdfs:label "Concept scheme"@en ;     rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:comment "A set of concepts forming one controlled vocabulary (SKOS)."@en .

# SKOS relations are used as annotation properties (OWL-DL-friendly SKOS)
skos:prefLabel    a owl:AnnotationProperty ; rdfs:label "preferred label"@en .
skos:hiddenLabel  a owl:AnnotationProperty ; rdfs:label "hidden label"@en .
skos:definition   a owl:AnnotationProperty ; rdfs:label "definition"@en .
skos:broader      a owl:AnnotationProperty ; rdfs:label "has broader"@en .
skos:inScheme     a owl:AnnotationProperty ; rdfs:label "is in scheme"@en .
skos:topConceptOf a owl:AnnotationProperty ; rdfs:label "is top concept in scheme"@en .
dcterms:title       a owl:AnnotationProperty ; rdfs:label "title"@en .
dcterms:description a owl:AnnotationProperty ; rdfs:label "description"@en .
dcterms:creator     a owl:AnnotationProperty ; rdfs:label "creator"@en .
dcterms:contributor a owl:AnnotationProperty ; rdfs:label "contributor"@en .
dcterms:license     a owl:AnnotationProperty ; rdfs:label "license"@en .
dcterms:created     a owl:AnnotationProperty ; rdfs:label "created"@en .
dcterms:abstract    a owl:AnnotationProperty ; rdfs:label "abstract"@en .
dcterms:modified    a owl:AnnotationProperty ; rdfs:label "modified"@en .
dcterms:bibliographicCitation a owl:AnnotationProperty ; rdfs:label "bibliographic citation"@en .
bibo:status         a owl:AnnotationProperty ; rdfs:label "status"@en .
vann:preferredNamespacePrefix a owl:AnnotationProperty ; rdfs:label "preferred namespace prefix"@en .
vann:preferredNamespaceUri    a owl:AnnotationProperty ; rdfs:label "preferred namespace URI"@en .

# ---------------------------------------------------------------------
#  WORLD LAYER
# ---------------------------------------------------------------------

ffonto:FireEvent a owl:Class ;
    rdfs:label "Fire event"@en ;
    rdfs:comment "A single fire incident that one or more data records are about. Identified in the data by event_id."@en ;
    rdfs:subClassOf sosa:FeatureOfInterest .

ffonto:Site a owl:Class ;
    rdfs:subClassOf sosa:FeatureOfInterest ;
    rdfs:label "Site"@en ;
    rdfs:comment "A named place or grid cell where data were recorded (weather station, camera site, grid cell)."@en .

ffonto:SceneEntity a owl:Class ;
    rdfs:subClassOf sosa:FeatureOfInterest ;
    rdfs:label "Scene entity"@en ;
    rdfs:comment "Something depicted in an image according to a scene description (a fire front, a firefighter, a building …). Its fine-grained kind is given by ffonto:hasKind → a concept in ffontov:EntityKindScheme."@en .

ffonto:FirePhenomenon   a owl:Class ; rdfs:subClassOf ffonto:SceneEntity ; rdfs:label "Fire phenomenon"@en ;
    rdfs:comment "Visible fire or smoke phenomenon: flame front, spot fire, crown fire, smoke plume, hotspot …"@en .
ffonto:Agent            a owl:Class ; rdfs:subClassOf ffonto:SceneEntity ; rdfs:label "Agent (person or animal)"@en ;
    rdfs:comment "A person or animal depicted in a scene."@en .
ffonto:Equipment        a owl:Class ; rdfs:subClassOf ffonto:SceneEntity ; rdfs:label "Equipment"@en ;
    rdfs:comment "Tools, hoses, pumps, radios and other portable gear depicted in a scene."@en .
ffonto:Vehicle          a owl:Class ; rdfs:subClassOf ffonto:SceneEntity ; rdfs:label "Vehicle"@en ;
    rdfs:comment "Ground vehicle or aircraft depicted in a scene."@en .
ffonto:BuiltAsset       a owl:Class ; rdfs:subClassOf ffonto:SceneEntity ; rdfs:label "Built asset"@en ;
    rdfs:comment "Building or infrastructure element depicted in a scene (house, road, bridge, power line, hydrant, tank, sign …)."@en .
ffonto:EnvironmentFeature a owl:Class ; rdfs:subClassOf ffonto:SceneEntity ; rdfs:label "Environment feature"@en ;
    rdfs:comment "Vegetation, terrain, water body or land-cover element depicted in a scene."@en .
ffonto:BurnEvidence     a owl:Class ; rdfs:subClassOf ffonto:SceneEntity ; rdfs:label "Burn evidence"@en ;
    rdfs:comment "Post-fire trace visible in a scene: ash, char, exposed mineral soil, snags, regrowth, erosion rills …"@en .

[] a owl:AllDisjointClasses ;
   owl:members ( ffonto:FirePhenomenon ffonto:Agent ffonto:Equipment ffonto:Vehicle ffonto:BuiltAsset ffonto:EnvironmentFeature ffonto:BurnEvidence ) .

# ---------------------------------------------------------------------
#  DATA LAYER (multimodal records)
# ---------------------------------------------------------------------

ffonto:DataRecord a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Data record"@en ;
    rdfs:comment "One captured data item (an image, an audio clip, a weather row) together with its metadata."@en .

ffonto:ImageRecord   a owl:Class ; rdfs:subClassOf ffonto:DataRecord ; rdfs:label "Image record"@en ;
    rdfs:comment "A still image or video frame record with its file, quality and geo metadata."@en .
ffonto:AudioRecord   a owl:Class ; rdfs:subClassOf ffonto:DataRecord ; rdfs:label "Audio record"@en ;
    rdfs:comment "An audio clip record with its file, duration and capture metadata."@en .
ffonto:WeatherRecord a owl:Class ; rdfs:subClassOf ffonto:DataRecord ; rdfs:label "Weather / FWI record"@en ;
    rdfs:comment "One row of the tabular weather and Fire Weather Index dataset."@en .

ffonto:ImageRecord   owl:disjointWith ffonto:AudioRecord , ffonto:WeatherRecord .
ffonto:AudioRecord   owl:disjointWith ffonto:WeatherRecord .

ffonto:Caption a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Caption"@en ;
    rdfs:comment "Text produced by an image-captioning model for an image record."@en .

ffonto:SceneDescription a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Scene description"@en ;
    rdfs:comment "Structured output of a scene-graph extractor (vision-language model or detector) for one image record: the entities it depicts, their states, activities and relations, plus scene-level attribute observations."@en .

# ---------------------------------------------------------------------
#  CLAIM LAYER (models, observations, thresholds)
# ---------------------------------------------------------------------

ffonto:Model a owl:Class ;
    rdfs:subClassOf prov:SoftwareAgent , sosa:Sensor ;
    rdfs:label "Model"@en ;
    rdfs:comment "A machine-learning model (classifier, captioner, audio tagger, vision-language model) that produces observations, captions or scene descriptions."@en .

ffonto:CaptureDevice a owl:Class ;
    rdfs:subClassOf sosa:Sensor ;
    rdfs:label "Capture device"@en ;
    rdfs:comment "Physical camera, microphone or weather station that captured a record."@en .

ffonto:ModelObservation a owl:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label "Model observation"@en ;
    rdfs:comment "A claim made by a model about a data record: either a predicted class with a confidence (ffonto:predictedClass) or a categorical value for an observable property (sosa:observedProperty + ffonto:hasValueConcept)."@en .

ffonto:Threshold a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Threshold"@en ;
    rdfs:comment "A configured decision threshold for one class (e.g. fire_threshold = 0.55)."@en .

ffonto:Hazard a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Hazard"@en ;
    rdfs:comment "A risk DERIVED by a rule from observations; typed by ffonto:hasHazardType → ffontov:HazardScheme concept and linked to what it threatens."@en .

ffonto:ModalityConflict a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Modality conflict"@en ;
    rdfs:comment "A derived finding that two observations about the same event or record disagree (e.g. audio explosion vs. no fire in image)."@en .

ffonto:DangerRule a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Danger rule"@en ;
    rdfs:comment "A threshold rule over a weather/FWI property (property, operator, value) that indicates an operational condition. Stored as data so experts can edit it."@en .

# ---------------------------------------------------------------------
#  OBJECT PROPERTIES
# ---------------------------------------------------------------------

ffonto:aboutEvent a owl:ObjectProperty ;
    rdfs:label "about event"@en ;
    rdfs:domain ffonto:DataRecord ; rdfs:range ffonto:FireEvent ;
    rdfs:comment "Links a record to the fire event it documents (from event_id). This is the cross-modal join key."@en .

ffonto:atSite a owl:ObjectProperty ;
    rdfs:label "at site"@en ; rdfs:domain ffonto:DataRecord ; rdfs:range ffonto:Site ;
    rdfs:comment "Links a record to the site or grid cell where it was captured."@en .

ffonto:capturedBy a owl:ObjectProperty ;
    rdfs:label "captured by"@en ; rdfs:domain ffonto:DataRecord ; rdfs:range ffonto:CaptureDevice ;
    rdfs:comment "Links a record to the physical device (camera, microphone, station) that captured it."@en .

ffonto:hasObservation a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ffonto:DataRecord ffonto:SceneDescription ) ] ;
    rdfs:label "has observation"@en ;
    rdfs:range ffonto:ModelObservation ;
    rdfs:comment "Links a record or a scene description to the model observations made about it."@en .

ffonto:predictedClass a owl:ObjectProperty ;
    rdfs:label "predicted class"@en ; rdfs:domain ffonto:ModelObservation ; rdfs:range skos:Concept ;
    rdfs:comment "The class a classifier observation predicts (e.g. Fire, Smoke, Explosion)."@en .

ffonto:hasValueConcept a owl:ObjectProperty ;
    rdfs:label "has value concept"@en ; rdfs:domain ffonto:ModelObservation ; rdfs:range skos:Concept ;
    rdfs:comment "Categorical result of an observation (e.g. SmokeColour → Gray)."@en .

ffonto:labelSource a owl:ObjectProperty ;
    rdfs:label "label source"@en ; rdfs:domain ffonto:ModelObservation ; rdfs:range skos:Concept ;
    rdfs:comment "Where the label of an observation came from (caption, zero-shot, detector, audio tagger, VLM, human)."@en .

ffonto:severity a owl:ObjectProperty ;
    rdfs:label "severity"@en ; rdfs:domain ffonto:ModelObservation ; rdfs:range skos:Concept ;
    rdfs:comment "Severity level assigned to an observation by the labelling pipeline."@en .

ffonto:usedThreshold a owl:ObjectProperty ;
    rdfs:label "used threshold"@en ; rdfs:domain ffonto:ModelObservation ; rdfs:range ffonto:Threshold ;
    rdfs:comment "The decision threshold that applies to the observation's predicted class."@en .

ffonto:forClass a owl:ObjectProperty ;
    rdfs:label "for class"@en ; rdfs:domain ffonto:Threshold ; rdfs:range skos:Concept ;
    rdfs:comment "The class a threshold applies to."@en .

ffonto:detectedClass a owl:ObjectProperty ;
    rdfs:label "detected class"@en ; rdfs:domain ffonto:DataRecord ; rdfs:range skos:Concept ;
    rdfs:comment "DERIVED (rule R02): a class whose observation confidence reached its threshold."@en .

ffonto:hasCaption a owl:ObjectProperty ;
    rdfs:label "has caption"@en ; rdfs:domain ffonto:ImageRecord ; rdfs:range ffonto:Caption ;
    rdfs:comment "Links an image record to the caption generated for it."@en .

ffonto:mentionsConcept a owl:ObjectProperty ;
    rdfs:label "mentions concept"@en ; rdfs:domain ffonto:Caption ; rdfs:range skos:Concept ;
    rdfs:comment "DERIVED (rule R03): the caption text contains one of the concept's labels."@en .

ffonto:describesRecord a owl:ObjectProperty ;
    rdfs:label "describes record"@en ; rdfs:domain ffonto:SceneDescription ; rdfs:range ffonto:ImageRecord ;
    rdfs:comment "Links a scene description to the image record it describes."@en .

ffonto:depicts a owl:ObjectProperty ;
    rdfs:label "depicts"@en ; rdfs:domain ffonto:SceneDescription ; rdfs:range ffonto:SceneEntity ;
    rdfs:comment "Links a scene description to an entity visible in the image."@en .

ffonto:hasKind a owl:ObjectProperty ;
    rdfs:label "has kind"@en ; rdfs:domain ffonto:SceneEntity ; rdfs:range skos:Concept ;
    rdfs:comment "Fine-grained kind of a scene entity, from ffontov:EntityKindScheme (e.g. ffontov:Pulaski, ffontov:Firefighter)."@en .

ffonto:hasState a owl:ObjectProperty ;
    rdfs:label "has state"@en ; rdfs:domain ffonto:SceneEntity ; rdfs:range skos:Concept ;
    rdfs:comment "Visible state or condition of a scene entity (ffontov:StateScheme), e.g. Scorched, Blocked, Dry."@en .

ffonto:performs a owl:ObjectProperty ;
    rdfs:label "performs"@en ; rdfs:domain ffonto:SceneEntity ; rdfs:range skos:Concept ;
    rdfs:comment "Activity being carried out by an agent or vehicle (ffontov:ActivityScheme)."@en .

ffonto:wears a owl:ObjectProperty ;
    rdfs:label "wears"@en ; rdfs:domain ffonto:Agent ; rdfs:range skos:Concept ;
    rdfs:comment "Protective equipment worn by a person (ffontov:PPEScheme)."@en .

ffonto:relativePosition a owl:ObjectProperty ;
    rdfs:label "relative position"@en ; rdfs:domain ffonto:SceneEntity ; rdfs:range skos:Concept ;
    rdfs:comment "Frame-relative position with respect to the fire (ffontov:PositionScheme: left flank, ahead of fire, ridge …)."@en .

ffonto:spatiallyRelated a owl:ObjectProperty ;
    rdfs:label "spatially related"@en ; rdfs:domain ffonto:SceneEntity ; rdfs:range ffonto:SceneEntity ;
    rdfs:comment "Super-property of all frame-relative spatial relations between scene entities."@en .
ffonto:near            a owl:ObjectProperty , owl:SymmetricProperty ; rdfs:domain ffonto:SceneEntity ; rdfs:range ffonto:SceneEntity ; rdfs:subPropertyOf ffonto:spatiallyRelated ; rdfs:label "near"@en ;
    rdfs:comment "Frame-relative proximity between two scene entities."@en .
ffonto:advancingToward a owl:ObjectProperty ; rdfs:domain ffonto:SceneEntity ; rdfs:range ffonto:SceneEntity ; rdfs:subPropertyOf ffonto:spatiallyRelated ; rdfs:label "advancing toward"@en ;
    rdfs:comment "The subject (typically fire) is moving toward the object in the frame."@en .
ffonto:reached         a owl:ObjectProperty ; rdfs:domain ffonto:SceneEntity ; rdfs:range ffonto:SceneEntity ; rdfs:subPropertyOf ffonto:spatiallyRelated ; rdfs:label "reached"@en ;
    rdfs:comment "The subject (typically fire) has reached the object (e.g. a river edge or farmland)."@en .
ffonto:protects        a owl:ObjectProperty ; rdfs:domain ffonto:SceneEntity ; rdfs:range ffonto:SceneEntity ; rdfs:subPropertyOf ffonto:spatiallyRelated ; rdfs:label "protects"@en ;
    rdfs:comment "The subject (resource or crew) is protecting the object (e.g. a building)."@en .
ffonto:blocks          a owl:ObjectProperty ; rdfs:domain ffonto:SceneEntity ; rdfs:range ffonto:SceneEntity ; rdfs:subPropertyOf ffonto:spatiallyRelated ; rdfs:label "blocks"@en ;
    rdfs:comment "The subject obstructs the object (e.g. a fallen tree blocks a road)."@en .

ffonto:hasHazardType a owl:ObjectProperty ;
    rdfs:label "has hazard type"@en ; rdfs:domain ffonto:Hazard ; rdfs:range skos:Concept ;
    rdfs:comment "Type of a derived hazard (ffontov:HazardScheme)."@en .

ffonto:threatens a owl:ObjectProperty ;
    rdfs:label "threatens"@en ; rdfs:domain ffonto:Hazard ;
    rdfs:comment "What the hazard endangers: a scene entity or a concept (e.g. ffontov:Firefighter as a group)."@en .

ffonto:inEvent a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ffonto:Hazard ffonto:ModalityConflict ) ] ;
    rdfs:label "in event"@en ; rdfs:range ffonto:FireEvent ;
    rdfs:comment "Event context of a derived hazard or conflict."@en .

ffonto:conflictType a owl:ObjectProperty ;
    rdfs:label "conflict type"@en ; rdfs:domain ffonto:ModalityConflict ; rdfs:range skos:Concept ;
    rdfs:comment "Type of a derived modality conflict (ffontov:ConflictScheme)."@en .

ffonto:involvesObservation a owl:ObjectProperty ;
    rdfs:label "involves observation"@en ; rdfs:domain ffonto:ModalityConflict ; rdfs:range ffonto:ModelObservation ;
    rdfs:comment "An observation that takes part in a modality conflict."@en .

ffonto:onProperty a owl:ObjectProperty ;
    rdfs:label "on property"@en ; rdfs:domain ffonto:DangerRule ;
    rdfs:comment "The weather/FWI datatype property the rule tests (e.g. ffonto:windSpeedKmh)."@en .

ffonto:indicatesCondition a owl:ObjectProperty ;
    rdfs:label "indicates condition"@en ; rdfs:domain ffonto:DangerRule ; rdfs:range skos:Concept ;
    rdfs:comment "The operational condition a danger rule indicates when it fires."@en .

ffonto:previousRecord a owl:ObjectProperty ;
    rdfs:label "previous record"@en ;
    rdfs:domain ffonto:WeatherRecord ; rdfs:range ffonto:WeatherRecord ;
    rdfs:comment "DERIVED (rule R08): the closest earlier dated weather record of the same site; used for trends (CQ09)."@en .

ffonto:hasCondition a owl:ObjectProperty ;
    rdfs:label "has condition"@en ; rdfs:domain ffonto:WeatherRecord ; rdfs:range skos:Concept ;
    rdfs:comment "DERIVED (rule R04): operational condition implied by a danger rule."@en .

# --- background knowledge links between concepts (used by CQ25, CQ26) ---
ffonto:mitigatedBy a owl:ObjectProperty ;
    rdfs:label "mitigated by"@en ; rdfs:domain skos:Concept ; rdfs:range skos:Concept ;
    rdfs:comment "Hazard concept → recommended action concept."@en .
ffonto:typicalFireImpact a owl:ObjectProperty ;
    rdfs:label "typical fire impact"@en ; rdfs:domain skos:Concept ; rdfs:range skos:Concept ;
    rdfs:comment "Ecosystem / vegetation kind → typical ecological impact of fire."@en .
ffonto:suggestedRestoration a owl:ObjectProperty ;
    rdfs:label "suggested restoration"@en ; rdfs:domain skos:Concept ; rdfs:range skos:Concept ;
    rdfs:comment "Ecosystem kind → restoration or recovery measure suggested after fire."@en .
ffonto:providesService a owl:ObjectProperty ;
    rdfs:label "provides ecosystem service"@en ; rdfs:domain skos:Concept ; rdfs:range skos:Concept ;
    rdfs:comment "Ecosystem kind → ecosystem service it provides (and that fire may impair)."@en .
ffonto:requiredPPE a owl:ObjectProperty ;
    rdfs:label "required PPE"@en ; rdfs:domain skos:Concept ; rdfs:range skos:Concept ;
    rdfs:comment "Person kind → PPE item that person must wear (used by SHACL and CQ17)."@en .

# ---------------------------------------------------------------------
#  DATATYPE PROPERTIES
# ---------------------------------------------------------------------

# --- record metadata (CQ02) ---
ffonto:recordUUID     a owl:DatatypeProperty ; rdfs:label "record UUID"@en ;       rdfs:domain ffonto:DataRecord ; rdfs:range xsd:string ;
    rdfs:comment "Unique identifier of a record (record_uuid)."@en .
ffonto:schemaVersion  a owl:DatatypeProperty ; rdfs:label "schema version"@en ;    rdfs:domain ffonto:DataRecord ; rdfs:range xsd:string ;
    rdfs:comment "Version of the record JSON schema."@en .
ffonto:mediaId        a owl:DatatypeProperty ; rdfs:label "media id"@en ;          rdfs:domain ffonto:DataRecord ; rdfs:range xsd:string ;
    rdfs:comment "Identifier of the media item (image_id)."@en .
ffonto:fileURI        a owl:DatatypeProperty ; rdfs:label "file URI / path"@en ;   rdfs:domain ffonto:DataRecord ; rdfs:range xsd:string ;
    rdfs:comment "Path or URI of the media file."@en .
ffonto:checksumSHA256 a owl:DatatypeProperty ; rdfs:label "checksum SHA-256"@en ;  rdfs:domain ffonto:DataRecord ; rdfs:range xsd:string ;
    rdfs:comment "SHA-256 checksum of the media file, for integrity and audit."@en .
ffonto:sourceName     a owl:DatatypeProperty ; rdfs:label "source name"@en ;       rdfs:domain ffonto:DataRecord ; rdfs:range xsd:string ;
    rdfs:comment "Name of the data source as recorded (e.g. unknown_camera)."@en .
ffonto:deviceId       a owl:DatatypeProperty ; rdfs:label "device id"@en ;         rdfs:domain ffonto:DataRecord ; rdfs:range xsd:string ;
    rdfs:comment "Identifier of the capture device."@en .
ffonto:captureTime    a owl:DatatypeProperty ; rdfs:label "capture time (UTC)"@en ; rdfs:domain ffonto:DataRecord ; rdfs:range xsd:dateTime ;
    rdfs:comment "UTC time at which the record was captured."@en .
ffonto:crs            a owl:DatatypeProperty ; rdfs:label "coordinate reference system"@en ; rdfs:domain ffonto:DataRecord ; rdfs:range xsd:string ;
    rdfs:comment "Coordinate reference system of the record's geometry (e.g. EPSG:4326)."@en .
ffonto:centerWKT      a owl:DatatypeProperty ; rdfs:label "center (WKT)"@en ;      rdfs:domain ffonto:DataRecord ; rdfs:range xsd:string ;
    rdfs:comment "Centre point of the record as WKT text."@en .
ffonto:footprintWKT   a owl:DatatypeProperty ; rdfs:label "footprint (WKT)"@en ;   rdfs:domain ffonto:DataRecord ; rdfs:range xsd:string ;
    rdfs:comment "Spatial footprint of the record as WKT text."@en .
ffonto:georeferenced  a owl:DatatypeProperty ; rdfs:label "georeferenced"@en ;     rdfs:domain ffonto:DataRecord ; rdfs:range xsd:boolean ;
    rdfs:comment "Whether the record carries georeference information."@en .
ffonto:widthPx        a owl:DatatypeProperty ; rdfs:label "width (px)"@en ;        rdfs:domain ffonto:ImageRecord ; rdfs:range xsd:integer ;
    rdfs:comment "Image width in pixels."@en .
ffonto:heightPx       a owl:DatatypeProperty ; rdfs:label "height (px)"@en ;       rdfs:domain ffonto:ImageRecord ; rdfs:range xsd:integer ;
    rdfs:comment "Image height in pixels."@en .
ffonto:resolutionM    a owl:DatatypeProperty ; rdfs:label "ground resolution (m)"@en ; rdfs:domain ffonto:ImageRecord ; rdfs:range xsd:double ;
    rdfs:comment "Ground sampling distance of the image in metres."@en .
ffonto:bands          a owl:DatatypeProperty ; rdfs:label "bands"@en ;             rdfs:domain ffonto:ImageRecord ; rdfs:range xsd:string ;
    rdfs:comment "Spectral bands of the image (e.g. RGB, IR)."@en .
ffonto:cloudCover     a owl:DatatypeProperty ; rdfs:label "cloud cover quality value"@en ; rdfs:domain ffonto:ImageRecord ; rdfs:range xsd:double ;
    rdfs:comment "Cloud-cover quality value recorded for the image."@en .
ffonto:blur           a owl:DatatypeProperty ; rdfs:label "blur quality value"@en ; rdfs:domain ffonto:ImageRecord ; rdfs:range xsd:double ;
    rdfs:comment "Blur quality value recorded for the image."@en .
ffonto:durationMs     a owl:DatatypeProperty ; rdfs:label "duration (ms)"@en ;     rdfs:domain ffonto:AudioRecord ; rdfs:range xsd:double ;
    rdfs:comment "Duration of the audio clip in milliseconds."@en .
ffonto:globalThreshold a owl:DatatypeProperty ; rdfs:label "global detection threshold"@en ; rdfs:domain ffonto:AudioRecord ; rdfs:range xsd:double ;
    rdfs:comment "Global detection threshold configured for the audio tagger."@en .
ffonto:regionName     a owl:DatatypeProperty ; rdfs:label "region name"@en ; rdfs:domain ffonto:DataRecord ;       rdfs:range xsd:string ;
    rdfs:comment "Name of the region where the record was captured."@en .
ffonto:eventCode      a owl:DatatypeProperty ; rdfs:label "event code"@en ;        rdfs:domain ffonto:FireEvent ; rdfs:range xsd:string ;
    rdfs:comment "Original event identifier string (event_id)."@en .

# --- observations & models (CQ03–CQ06, CQ23) ---
ffonto:confidence      a owl:DatatypeProperty ; rdfs:label "confidence"@en ;       rdfs:domain ffonto:ModelObservation ; rdfs:range xsd:double ;
    rdfs:comment "Confidence or score of an observation (for audio: mean confidence)."@en .
ffonto:meanConfidence  a owl:DatatypeProperty ; rdfs:label "mean confidence"@en ;  rdfs:domain ffonto:ModelObservation ; rdfs:range xsd:double ;
    rdfs:comment "Mean frame-level confidence of an audio event."@en .
ffonto:maxConfidence   a owl:DatatypeProperty ; rdfs:label "max confidence"@en ;   rdfs:domain ffonto:ModelObservation ; rdfs:range xsd:double ;
    rdfs:comment "Maximum frame-level confidence of an audio event."@en .
ffonto:topKLabel       a owl:DatatypeProperty ; rdfs:label "top-k frame label"@en ; rdfs:domain ffonto:ModelObservation ; rdfs:range xsd:string ;
    rdfs:comment "One of the top-k frame labels reported by the audio tagger."@en .
ffonto:labelCategory   a owl:DatatypeProperty ; rdfs:label "label category"@en ;   rdfs:domain ffonto:ModelObservation ; rdfs:range xsd:string ;
    rdfs:comment "Category of a raw label as given by the pipeline (e.g. fire_audio)."@en .
ffonto:count           a owl:DatatypeProperty ; rdfs:label "count"@en ; rdfs:domain ffonto:SceneEntity ;            rdfs:range xsd:integer ;
    rdfs:comment "Number of instances represented by a scene entity (e.g. 3 firefighters)."@en .
ffonto:aboveThreshold  a owl:DatatypeProperty ; rdfs:label "above threshold"@en ;  rdfs:domain ffonto:ModelObservation ; rdfs:range xsd:boolean ;
    rdfs:comment "DERIVED (rule R01)."@en .
ffonto:humanValidated  a owl:DatatypeProperty ; rdfs:label "human validated"@en ; rdfs:domain ffonto:SceneDescription ;  rdfs:range xsd:boolean ;
    rdfs:comment "Whether a human has validated the output."@en .
ffonto:thresholdValue  a owl:DatatypeProperty ; rdfs:label "threshold value"@en ; rdfs:domain [ a owl:Class ; owl:unionOf ( ffonto:Threshold ffonto:DangerRule ) ] ;  rdfs:range xsd:double ;
    rdfs:comment "Numeric value of a threshold."@en .
ffonto:operator        a owl:DatatypeProperty ; rdfs:label "operator"@en ;         rdfs:domain ffonto:DangerRule ; rdfs:range xsd:string ;
    rdfs:comment "Comparison operator: \"gt\", \"ge\", \"lt\", \"le\"."@en .
ffonto:captionText     a owl:DatatypeProperty ; rdfs:label "caption text"@en ;     rdfs:domain ffonto:Caption ; rdfs:range xsd:string ;
    rdfs:comment "Text of a generated caption."@en .
ffonto:modelName       a owl:DatatypeProperty ; rdfs:label "model name"@en ;       rdfs:domain ffonto:Model ; rdfs:range xsd:string ;
    rdfs:comment "Name or repository id of a model."@en .
ffonto:modelVersion    a owl:DatatypeProperty ; rdfs:label "model version"@en ;    rdfs:domain ffonto:Model ; rdfs:range xsd:string ;
    rdfs:comment "Version of a model."@en .
ffonto:modelURL        a owl:DatatypeProperty ; rdfs:label "model provenance URL"@en ; rdfs:domain ffonto:Model ; rdfs:range xsd:anyURI ;
    rdfs:comment "URL documenting the model's provenance (e.g. TF-Hub or Hugging Face page)."@en .
ffonto:classMapSHA1    a owl:DatatypeProperty ; rdfs:label "class map SHA-1"@en ;  rdfs:domain ffonto:Model ; rdfs:range xsd:string ;
    rdfs:comment "SHA-1 checksum of the model's class map, for audit."@en .
ffonto:frameStrideS    a owl:DatatypeProperty ; rdfs:label "frame stride (s)"@en ; rdfs:domain ffonto:Model ; rdfs:range xsd:double ;
    rdfs:comment "Frame stride of an audio model in seconds."@en .
ffonto:topK            a owl:DatatypeProperty ; rdfs:label "top-k"@en ;            rdfs:domain ffonto:Model ; rdfs:range xsd:integer ;
    rdfs:comment "Number of top labels the model reports per frame."@en .

# --- weather & FWI (CQ08–CQ10) ---
ffonto:observationDate  a owl:DatatypeProperty ; rdfs:label "observation date"@en ; rdfs:domain ffonto:WeatherRecord ; rdfs:range xsd:dateTime ;
    rdfs:comment "Date of a weather/FWI record (stored as xsd:dateTime at 00:00 UTC)."@en .
ffonto:dayName          a owl:DatatypeProperty ; rdfs:label "day name"@en ;          rdfs:domain ffonto:WeatherRecord ; rdfs:range xsd:string ;
    rdfs:comment "Day-of-week name as given in the source table."@en .
ffonto:airTemperatureC  a owl:DatatypeProperty ; rdfs:label "air temperature (°C)"@en ; rdfs:domain ffonto:WeatherRecord ; rdfs:range xsd:double ;
    rdfs:comment "Air temperature in degrees Celsius."@en .
ffonto:relativeHumidityPct a owl:DatatypeProperty ; rdfs:label "relative humidity (%)"@en ; rdfs:domain ffonto:WeatherRecord ; rdfs:range xsd:double ;
    rdfs:comment "Relative humidity in percent."@en .
ffonto:windSpeedKmh     a owl:DatatypeProperty ; rdfs:label "wind speed (km/h)"@en ;  rdfs:domain ffonto:WeatherRecord ; rdfs:range xsd:double ;
    rdfs:comment "Wind speed in km/h."@en .
ffonto:rainMm           a owl:DatatypeProperty ; rdfs:label "rain (mm)"@en ;          rdfs:domain ffonto:WeatherRecord ; rdfs:range xsd:double ;
    rdfs:comment "Rainfall in millimetres."@en .
ffonto:ffmc             a owl:DatatypeProperty ; rdfs:label "FFMC"@en ; rdfs:comment "Fine Fuel Moisture Code"@en ;   rdfs:domain ffonto:WeatherRecord ; rdfs:range xsd:double .
ffonto:dmc              a owl:DatatypeProperty ; rdfs:label "DMC"@en ;  rdfs:comment "Duff Moisture Code"@en ;        rdfs:domain ffonto:WeatherRecord ; rdfs:range xsd:double .
ffonto:dc               a owl:DatatypeProperty ; rdfs:label "DC"@en ;   rdfs:comment "Drought Code"@en ;              rdfs:domain ffonto:WeatherRecord ; rdfs:range xsd:double .
ffonto:isi              a owl:DatatypeProperty ; rdfs:label "ISI"@en ;  rdfs:comment "Initial Spread Index"@en ;      rdfs:domain ffonto:WeatherRecord ; rdfs:range xsd:double .
ffonto:bui              a owl:DatatypeProperty ; rdfs:label "BUI"@en ;  rdfs:comment "Buildup Index"@en ;             rdfs:domain ffonto:WeatherRecord ; rdfs:range xsd:double .
ffonto:fwi              a owl:DatatypeProperty ; rdfs:label "FWI"@en ;  rdfs:comment "Fire Weather Index"@en ;        rdfs:domain ffonto:WeatherRecord ; rdfs:range xsd:double .
ffonto:fireOccurred     a owl:DatatypeProperty ; rdfs:label "fire occurred"@en ;      rdfs:domain ffonto:WeatherRecord ; rdfs:range xsd:boolean ;
    rdfs:comment "Whether a fire occurred on this date at this site (fire_occured)."@en .
ffonto:burnedAreaHa     a owl:DatatypeProperty ; rdfs:label "burned area (ha)"@en ;   rdfs:domain ffonto:WeatherRecord ; rdfs:range xsd:double ;
    rdfs:comment "Burned area in hectares."@en .

# --- site ---
ffonto:siteName  a owl:DatatypeProperty ; rdfs:label "site name"@en ; rdfs:domain ffonto:Site ; rdfs:range xsd:string ;
    rdfs:comment "Name of a site."@en .
ffonto:country   a owl:DatatypeProperty ; rdfs:label "country"@en ;   rdfs:domain ffonto:Site ; rdfs:range xsd:string ;
    rdfs:comment "Country of a site."@en .
ffonto:gridX     a owl:DatatypeProperty ; rdfs:label "grid x"@en ;    rdfs:domain ffonto:Site ; rdfs:range xsd:integer ;
    rdfs:comment "X coordinate of the site's grid cell."@en .
ffonto:gridY     a owl:DatatypeProperty ; rdfs:label "grid y"@en ;    rdfs:domain ffonto:Site ; rdfs:range xsd:integer ;
    rdfs:comment "Y coordinate of the site's grid cell."@en .

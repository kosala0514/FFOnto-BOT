@prefix ffo:  <http://purl.org/ffonto#> .
@prefix ffv:  <http://purl.org/ffonto/vocab#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# =====================================================================
#  FFOnto v2 — CONTROLLED VOCABULARY (SKOS)
#  Fine-grained kinds and values live here as skos:Concept, organised
#  with skos:broader. Add new kinds HERE (no schema change needed).
#  skos:hiddenLabel = keywords used for caption tagging (rule R03) and
#  for the scene-extraction prompt.
# =====================================================================

<http://purl.org/ffonto/vocab>
    a owl:Ontology ;
    rdfs:label "FFOnto vocabulary"@en ;
    owl:versionIRI <http://purl.org/ffonto/vocab/2.0.0> ;
    owl:versionInfo "2.0.0" ;
    dcterms:title "FFOnto controlled vocabulary"@en ;
    dcterms:abstract "SKOS controlled vocabulary of FFOnto: the fine-grained kinds and values used in forest-fire knowledge graphs (detection classes, sound events, scene entity kinds, states, activities, PPE, positions, observable properties, values, hazards, actions, weather conditions, modality conflicts and ecological background knowledge). New kinds are added here as concepts under skos:broader, without changing the core schema."@en ;
    dcterms:description "SKOS concept schemes for FFOnto: entity kinds, states, activities, PPE, observable properties, values, hazards, actions, conditions and ecological background knowledge. skos:hiddenLabel holds the keywords used for caption tagging and for the scene-extraction prompt. Load together with ffonto-core.ttl (see ffonto.ttl and catalog-v001.xml)."@en ;
    dcterms:creator "Charuni Kosala Jayaweera" ;
    dcterms:contributor "Prof. Dulani Meedeniya" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-10-07"^^xsd:date ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    vann:preferredNamespacePrefix "ffv" ;
    vann:preferredNamespaceUri "http://purl.org/ffonto/vocab#" .



# ---------------- Detection classes ----------------
ffv:DetectionClassScheme a skos:ConceptScheme ;
    rdfs:label "Detection classes (scheme)"@en ;
    skos:prefLabel "Detection classes"@en ;
    skos:definition "Classes predicted by image fire/smoke classifiers."@en .
ffv:Fire a skos:Concept ;
    rdfs:label "Fire"@en ;
    skos:prefLabel "Fire"@en ;
    skos:inScheme ffv:DetectionClassScheme ;
    skos:topConceptOf ffv:DetectionClassScheme ;
    skos:hiddenLabel "fire"@en , "flame"@en , "flames"@en , "blaze"@en , "burning"@en .
ffv:Smoke a skos:Concept ;
    rdfs:label "Smoke"@en ;
    skos:prefLabel "Smoke"@en ;
    skos:inScheme ffv:DetectionClassScheme ;
    skos:topConceptOf ffv:DetectionClassScheme ;
    skos:hiddenLabel "smoke"@en , "smoky"@en , "haze"@en .
ffv:NoFire a skos:Concept ;
    rdfs:label "No fire"@en ;
    skos:prefLabel "No fire"@en ;
    skos:inScheme ffv:DetectionClassScheme ;
    skos:topConceptOf ffv:DetectionClassScheme ;
    skos:hiddenLabel "no fire"@en .

# ---------------- Sound events ----------------
ffv:SoundEventScheme a skos:ConceptScheme ;
    rdfs:label "Sound events (scheme)"@en ;
    skos:prefLabel "Sound events"@en ;
    skos:definition "Audio event classes (aligned with AudioSet/YAMNet labels where possible)."@en .
ffv:FireSound a skos:Concept ;
    rdfs:label "Fire-related sound"@en ;
    skos:prefLabel "Fire-related sound"@en ;
    skos:inScheme ffv:SoundEventScheme ;
    skos:topConceptOf ffv:SoundEventScheme .
ffv:Crackling a skos:Concept ;
    rdfs:label "Crackling"@en ;
    skos:prefLabel "Crackling"@en ;
    skos:inScheme ffv:SoundEventScheme ;
    skos:broader ffv:FireSound ;
    skos:hiddenLabel "crackle"@en , "crackling"@en .
ffv:Explosion a skos:Concept ;
    rdfs:label "Explosion"@en ;
    skos:prefLabel "Explosion"@en ;
    skos:inScheme ffv:SoundEventScheme ;
    skos:broader ffv:FireSound ;
    skos:hiddenLabel "explosion"@en , "burst"@en , "boom"@en .
ffv:Siren a skos:Concept ;
    rdfs:label "Siren"@en ;
    skos:prefLabel "Siren"@en ;
    skos:inScheme ffv:SoundEventScheme ;
    skos:topConceptOf ffv:SoundEventScheme ;
    skos:hiddenLabel "siren"@en , "emergency vehicle"@en , "fire engine, fire truck (siren)"@en .
ffv:LoudActivity a skos:Concept ;
    rdfs:label "Sustained loud activity"@en ;
    skos:prefLabel "Sustained loud activity"@en ;
    skos:inScheme ffv:SoundEventScheme ;
    skos:topConceptOf ffv:SoundEventScheme ;
    skos:hiddenLabel "loud"@en , "roar"@en .
ffv:Speech a skos:Concept ;
    rdfs:label "Speech"@en ;
    skos:prefLabel "Speech"@en ;
    skos:inScheme ffv:SoundEventScheme ;
    skos:topConceptOf ffv:SoundEventScheme ;
    skos:hiddenLabel "speech"@en .
ffv:VehicleSound a skos:Concept ;
    rdfs:label "Vehicle sound"@en ;
    skos:prefLabel "Vehicle sound"@en ;
    skos:inScheme ffv:SoundEventScheme ;
    skos:topConceptOf ffv:SoundEventScheme ;
    skos:hiddenLabel "vehicle"@en , "engine"@en .


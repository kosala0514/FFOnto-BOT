# ---------------- kind ↔ core class alignment ----------------
ffv:FirePhenomenonKind     rdfs:seeAlso ffo:FirePhenomenon .
ffv:AgentKind              rdfs:seeAlso ffo:Agent .
ffv:EquipmentKind          rdfs:seeAlso ffo:Equipment .
ffv:VehicleKind            rdfs:seeAlso ffo:Vehicle .
ffv:BuiltAssetKind         rdfs:seeAlso ffo:BuiltAsset .
ffv:EnvironmentFeatureKind rdfs:seeAlso ffo:EnvironmentFeature .
ffv:BurnEvidenceKind       rdfs:seeAlso ffo:BurnEvidence .


# =====================================================================
#  BACKGROUND KNOWLEDGE (edit with domain experts)
# =====================================================================

# --- hazard → recommended action (CQ25) ---
ffv:FlameProximity          ffo:mitigatedBy ffv:WithdrawToSafetyZone , ffv:PostLookouts , ffv:WearFullPPE .
ffv:StructureIgnitionRisk   ffo:mitigatedBy ffv:DefensiveStrategy , ffv:EvacuateImmediately .
ffv:ExplosionHazard         ffo:mitigatedBy ffv:CoolAndIsolateTank , ffv:WithdrawToSafetyZone .
ffv:SmokeVisibilityHazard   ffo:mitigatedBy ffv:CloseRoad , ffv:UseHeadlightsAndSlowDown .
ffv:RespiratoryHazard       ffo:mitigatedBy ffv:WearRespirator , ffv:ShelterInPlace .
ffv:DownedPowerLineHazard   ffo:mitigatedBy ffv:DeEnergiseLines , ffv:CloseRoad .
ffv:MissingPPEHazard        ffo:mitigatedBy ffv:WearFullPPE .
ffv:CrownFireTransition     ffo:mitigatedBy ffv:RequestAerialSupport , ffv:WithdrawToSafetyZone .
ffv:SpottingHazard          ffo:mitigatedBy ffv:PostLookouts , ffv:MopUpAndPatrol .
ffv:EvacuationRouteBlocked  ffo:mitigatedBy ffv:ShelterInPlace , ffv:CloseRoad .
ffv:FallingTreeHazard       ffo:mitigatedBy ffv:AvoidSnagAreas .
ffv:ReignitionHazard        ffo:mitigatedBy ffv:MopUpAndPatrol .
ffv:ErosionRisk             ffo:mitigatedBy ffv:InstallErosionControl .
ffv:WildlifeThreat          ffo:mitigatedBy ffv:EvacuateImmediately .

# --- required PPE per person kind (CQ17 + SHACL) ---
ffv:Firefighter ffo:requiredPPE ffv:Helmet , ffv:FireResistantClothing , ffv:Gloves , ffv:EyeProtection .

# --- ecosystem kind → typical impacts / services / restoration (CQ26) ---
ffv:ConiferousForest
    ffo:typicalFireImpact ffv:TreeMortality , ffv:HabitatLoss , ffv:CarbonRelease , ffv:SoilErosion , ffv:SeedReleaseAndRegeneration ;
    ffo:providesService ffv:CarbonStorage , ffv:HabitatProvision , ffv:WaterRegulation ;
    ffo:suggestedRestoration ffv:NaturalRegenerationMonitoring , ffv:Reforestation , ffv:ErosionControl .
ffv:DeciduousForest
    ffo:typicalFireImpact ffv:TreeMortality , ffv:HabitatLoss , ffv:SoilNutrientLoss ;
    ffo:providesService ffv:CarbonStorage , ffv:HabitatProvision ;
    ffo:suggestedRestoration ffv:NaturalRegenerationMonitoring , ffv:Reforestation .
ffv:MixedForest
    ffo:typicalFireImpact ffv:TreeMortality , ffv:HabitatLoss , ffv:CarbonRelease ;
    ffo:providesService ffv:CarbonStorage , ffv:HabitatProvision ;
    ffo:suggestedRestoration ffv:NaturalRegenerationMonitoring , ffv:Reforestation .
ffv:Grassland
    ffo:typicalFireImpact ffv:NutrientRecycling , ffv:InvasiveSpeciesSpread , ffv:SoilErosion ;
    ffo:providesService ffv:Grazing , ffv:SoilProtection ;
    ffo:suggestedRestoration ffv:Reseeding , ffv:InvasiveSpeciesControl .
ffv:Shrubland
    ffo:typicalFireImpact ffv:SoilErosion , ffv:InvasiveSpeciesSpread , ffv:HabitatLoss ;
    ffo:providesService ffv:SoilProtection , ffv:HabitatProvision ;
    ffo:suggestedRestoration ffv:ErosionControl , ffv:Reseeding .
ffv:WaterBody
    ffo:typicalFireImpact ffv:WaterQualityDegradation ;
    ffo:providesService ffv:WaterRegulation ;
    ffo:suggestedRestoration ffv:RiparianRestoration .
ffv:PrescribedBurn
    ffo:typicalFireImpact ffv:NutrientRecycling , ffv:SeedReleaseAndRegeneration ;
    ffo:suggestedRestoration ffv:FuelManagement .


# =====================================================================
#  BACKGROUND KNOWLEDGE (edit with domain experts)
# =====================================================================

# --- hazard → recommended action (CQ25) ---
ffontov:FlameProximity          ffonto:mitigatedBy ffontov:WithdrawToSafetyZone , ffontov:PostLookouts , ffontov:WearFullPPE .
ffontov:StructureIgnitionRisk   ffonto:mitigatedBy ffontov:DefensiveStrategy , ffontov:EvacuateImmediately .
ffontov:ExplosionHazard         ffonto:mitigatedBy ffontov:CoolAndIsolateTank , ffontov:WithdrawToSafetyZone .
ffontov:SmokeVisibilityHazard   ffonto:mitigatedBy ffontov:CloseRoad , ffontov:UseHeadlightsAndSlowDown .
ffontov:RespiratoryHazard       ffonto:mitigatedBy ffontov:WearRespirator , ffontov:ShelterInPlace .
ffontov:DownedPowerLineHazard   ffonto:mitigatedBy ffontov:DeEnergiseLines , ffontov:CloseRoad .
ffontov:MissingPPEHazard        ffonto:mitigatedBy ffontov:WearFullPPE .
ffontov:CrownFireTransition     ffonto:mitigatedBy ffontov:RequestAerialSupport , ffontov:WithdrawToSafetyZone .
ffontov:SpottingHazard          ffonto:mitigatedBy ffontov:PostLookouts , ffontov:MopUpAndPatrol .
ffontov:EvacuationRouteBlocked  ffonto:mitigatedBy ffontov:ShelterInPlace , ffontov:CloseRoad .
ffontov:FallingTreeHazard       ffonto:mitigatedBy ffontov:AvoidSnagAreas .
ffontov:ReignitionHazard        ffonto:mitigatedBy ffontov:MopUpAndPatrol .
ffontov:ErosionRisk             ffonto:mitigatedBy ffontov:InstallErosionControl .
ffontov:WildlifeThreat          ffonto:mitigatedBy ffontov:EvacuateImmediately .

# --- required PPE per person kind (CQ17 + SHACL) ---
ffontov:Firefighter ffonto:requiredPPE ffontov:Helmet , ffontov:FireResistantClothing , ffontov:Gloves , ffontov:EyeProtection .

# --- ecosystem kind → typical impacts / services / restoration (CQ26) ---
ffontov:ConiferousForest
    ffonto:typicalFireImpact ffontov:TreeMortality , ffontov:HabitatLoss , ffontov:CarbonRelease , ffontov:SoilErosion , ffontov:SeedReleaseAndRegeneration ;
    ffonto:providesService ffontov:CarbonStorage , ffontov:HabitatProvision , ffontov:WaterRegulation ;
    ffonto:suggestedRestoration ffontov:NaturalRegenerationMonitoring , ffontov:Reforestation , ffontov:ErosionControl .
ffontov:DeciduousForest
    ffonto:typicalFireImpact ffontov:TreeMortality , ffontov:HabitatLoss , ffontov:SoilNutrientLoss ;
    ffonto:providesService ffontov:CarbonStorage , ffontov:HabitatProvision ;
    ffonto:suggestedRestoration ffontov:NaturalRegenerationMonitoring , ffontov:Reforestation .
ffontov:MixedForest
    ffonto:typicalFireImpact ffontov:TreeMortality , ffontov:HabitatLoss , ffontov:CarbonRelease ;
    ffonto:providesService ffontov:CarbonStorage , ffontov:HabitatProvision ;
    ffonto:suggestedRestoration ffontov:NaturalRegenerationMonitoring , ffontov:Reforestation .
ffontov:Grassland
    ffonto:typicalFireImpact ffontov:NutrientRecycling , ffontov:InvasiveSpeciesSpread , ffontov:SoilErosion ;
    ffonto:providesService ffontov:Grazing , ffontov:SoilProtection ;
    ffonto:suggestedRestoration ffontov:Reseeding , ffontov:InvasiveSpeciesControl .
ffontov:Shrubland
    ffonto:typicalFireImpact ffontov:SoilErosion , ffontov:InvasiveSpeciesSpread , ffontov:HabitatLoss ;
    ffonto:providesService ffontov:SoilProtection , ffontov:HabitatProvision ;
    ffonto:suggestedRestoration ffontov:ErosionControl , ffontov:Reseeding .
ffontov:WaterBody
    ffonto:typicalFireImpact ffontov:WaterQualityDegradation ;
    ffonto:providesService ffontov:WaterRegulation ;
    ffonto:suggestedRestoration ffontov:RiparianRestoration .
ffontov:PrescribedBurn
    ffonto:typicalFireImpact ffontov:NutrientRecycling , ffontov:SeedReleaseAndRegeneration ;
    ffonto:suggestedRestoration ffontov:FuelManagement .


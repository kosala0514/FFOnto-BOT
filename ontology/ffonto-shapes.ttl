@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ffonto:  <http://purl.org/ffonto#> .
@prefix ffontov:  <http://purl.org/ffonto/vocab#> .
@prefix ffs:  <http://purl.org/ffonto/shapes#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# =====================================================================
#  SHACL shapes — data-quality and completeness checks
#  Answers CQ02 ("which metadata fields are missing?") and the
#  alert-readiness part of CQ07, plus the "missing PPE" part of CQ17.
#  sh:Violation = must fix ; sh:Warning = report only.
# =====================================================================

ffs: sh:declare
    [ sh:prefix "ffonto" ; sh:namespace "http://purl.org/ffonto#"^^xsd:anyURI ] ,
    [ sh:prefix "ffontov" ; sh:namespace "http://purl.org/ffonto/vocab#"^^xsd:anyURI ] ,
    [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] .

# ---------------- every record ----------------
ffs:DataRecordShape a sh:NodeShape ;
    sh:targetClass ffonto:ImageRecord , ffonto:AudioRecord ;
    sh:property [ sh:path ffonto:recordUUID ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "Record has no record_uuid." ] ;
    sh:property [ sh:path ffonto:aboutEvent ; sh:minCount 1 ; sh:class ffonto:FireEvent ;
                  sh:message "Record is not linked to any fire event (event_id missing) – it cannot be fused with other modalities." ] ;
    sh:property [ sh:path ffonto:fileURI ; sh:minCount 1 ;
                  sh:message "Record has no file path / URI." ] ;
    sh:property [ sh:path ffonto:captureTime ; sh:minCount 1 ; sh:severity sh:Warning ;
                  sh:message "capture_time_utc missing – temporal pairing across modalities is impossible." ] ;
    sh:property [ sh:path ffonto:crs ; sh:minCount 1 ; sh:severity sh:Warning ;
                  sh:message "CRS missing – record cannot be located on a map." ] .

ffs:ImageRecordShape a sh:NodeShape ;
    sh:targetClass ffonto:ImageRecord ;
    sh:property [ sh:path ffonto:checksumSHA256 ; sh:minCount 1 ; sh:pattern "^[0-9a-f]{64}$" ;
                  sh:message "Image checksum (SHA-256) missing or malformed." ] ;
    sh:property [ sh:path <http://purl.org/dc/terms/license> ; sh:minCount 1 ; sh:severity sh:Warning ;
                  sh:message "Image licence not recorded." ] ;
    sh:property [ sh:path ffonto:widthPx ; sh:minCount 1 ; sh:datatype xsd:integer ; sh:severity sh:Warning ] ;
    sh:property [ sh:path ffonto:heightPx ; sh:minCount 1 ; sh:datatype xsd:integer ; sh:severity sh:Warning ] ;
    sh:property [ sh:path ffonto:footprintWKT ; sh:minCount 1 ; sh:severity sh:Info ;
                  sh:message "No spatial footprint stored." ] ;
    sh:property [ sh:path ffonto:resolutionM ; sh:minCount 1 ; sh:severity sh:Info ;
                  sh:message "Ground resolution (resolution_m) not recorded." ] .

# ---------------- model observations (alert readiness, CQ07) ----------------
ffs:ObservationShape a sh:NodeShape ;
    sh:targetClass ffonto:ModelObservation ;
    sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:class ffonto:Model ;
                  sh:message "Observation has no producing model – not auditable." ] ;
    sh:or ( [ sh:path ffonto:predictedClass ; sh:minCount 1 ]
            [ sh:path ffonto:hasValueConcept ; sh:minCount 1 ] ) .

ffs:AlertReadyShape a sh:NodeShape ;
    sh:targetClass ffonto:ModelObservation ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ffs: ;
        sh:message "Classifier observation is not alert-ready: it needs a confidence and a threshold." ;
        sh:select """
            SELECT $this WHERE {
              $this ffonto:predictedClass ?c .
              FILTER ( NOT EXISTS { $this ffonto:confidence ?x } || NOT EXISTS { $this ffonto:usedThreshold ?t } )
            }""" ] .

ffs:ModelShape a sh:NodeShape ;
    sh:targetClass ffonto:Model ;
    sh:property [ sh:path ffonto:modelName ; sh:minCount 1 ] ;
    sh:property [ sh:path ffonto:modelVersion ; sh:minCount 1 ; sh:severity sh:Warning ;
                  sh:message "Model version not recorded – results are not reproducible." ] .

# ---------------- weather rows ----------------
ffs:WeatherRecordShape a sh:NodeShape ;
    sh:targetClass ffonto:WeatherRecord ;
    sh:property [ sh:path ffonto:observationDate ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path ffonto:observationDate ; sh:minCount 1 ; sh:severity sh:Warning ;
                  sh:message "Weather row has no complete date – it cannot be used for date-based questions (CQ08 'today', CQ09 trend)." ] ;
    sh:property [ sh:path ffonto:atSite ; sh:minCount 1 ] ;
    sh:property [ sh:path ffonto:relativeHumidityPct ; sh:minInclusive 0 ; sh:maxInclusive 100 ] ;
    sh:property [ sh:path ffonto:ffmc ; sh:minInclusive 0 ; sh:maxInclusive 101 ] ;
    sh:property [ sh:path ffonto:aboutEvent ; sh:minCount 1 ; sh:severity sh:Warning ;
                  sh:message "Weather row not linked to a fire event – it cannot be compared with image/audio of that event." ] .

# ---------------- firefighters must wear required PPE (CQ17) ----------------
ffs:RequiredPPEShape a sh:NodeShape ;
    sh:targetClass ffonto:Agent ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ffs: ;
        sh:message "Person is not seen wearing required PPE: {?ppe}" ;
        sh:select """
            SELECT $this ?ppe WHERE {
              $this ffonto:hasKind ?kind .
              ?kind ffonto:requiredPPE ?ppe .
              FILTER NOT EXISTS { $this ffonto:wears ?ppe }
            }""" ] .

# RULE R00_entity_class
# Type every scene entity with its core class from its SKOS kind (Pulaski → ffonto:Equipment).
# Executed in file-name order by scripts/run_cqs.py (CONSTRUCT results are added to the graph).

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffontov:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

CONSTRUCT { ?e a ?cls }
WHERE {
  ?e ffonto:hasKind ?kind .
  ?kind skos:broader* ?top .
  ?top rdfs:seeAlso ?cls .
  FILTER(STRSTARTS(STR(?cls), "http://purl.org/ffonto#"))
}

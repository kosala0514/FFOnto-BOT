# RULE R04_danger_conditions
# Apply the weather / FWI danger rules (ontology/danger-rules.ttl) to every weather record.
# Executed in file-name order by scripts/run_cqs.py (CONSTRUCT results are added to the graph).

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffv:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

CONSTRUCT { ?w ffonto:hasCondition ?cond }
WHERE {
  ?rule a ffonto:DangerRule ;
        ffonto:onProperty ?p ;
        ffonto:operator ?op ;
        ffonto:thresholdValue ?t ;
        ffonto:indicatesCondition ?cond .
  ?w a ffonto:WeatherRecord ;
     ?p ?v .
  FILTER( (?op = "gt" && ?v >  ?t) || (?op = "ge" && ?v >= ?t) ||
          (?op = "lt" && ?v <  ?t) || (?op = "le" && ?v <= ?t) )
}

# RULE R08_previous_weather_record
# Link each dated weather row to the previous dated row of the same site (used for the FWI trend in CQ09).
# Executed in file-name order by scripts/run_cqs.py (CONSTRUCT results are added to the graph).

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffv:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

CONSTRUCT { ?w ffonto:previousRecord ?wPrev }
WHERE {
  {
    SELECT ?w ?s (MAX(?d2) AS ?prevDate)
    WHERE {
      ?w  a ffonto:WeatherRecord ; ffonto:atSite ?s ; ffonto:observationDate ?d1 .
      ?w2 a ffonto:WeatherRecord ; ffonto:atSite ?s ; ffonto:observationDate ?d2 .
      FILTER(?d2 < ?d1)
    }
    GROUP BY ?w ?s
  }
  ?wPrev a ffonto:WeatherRecord ; ffonto:atSite ?s ; ffonto:observationDate ?prevDate .
}

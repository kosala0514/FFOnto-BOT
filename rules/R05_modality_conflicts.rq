# RULE R05_modality_conflicts
# Detect disagreements between modalities / models (feeds CQ07).
# Executed in file-name order by scripts/run_cqs.py (CONSTRUCT results are added to the graph).

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffv:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

CONSTRUCT {
  ?x a ffonto:ModalityConflict ;
     ffonto:conflictType ?type ;
     ffonto:inEvent ?ev ;
     ffonto:involvesObservation ?o1 , ?o2 ;
     rdfs:comment ?why .
}
WHERE {
  {
    # (a) audio says explosion, image classifier says fire is below threshold
    ?a a ffonto:AudioRecord ; ffonto:aboutEvent ?ev ; ffonto:hasObservation ?o1 .
    ?o1 ffonto:predictedClass ffv:Explosion ; ffonto:aboveThreshold true .
    ?i a ffonto:ImageRecord ; ffonto:aboutEvent ?ev ; ffonto:hasObservation ?o2 .
    ?o2 ffonto:predictedClass ffv:Fire ; ffonto:aboveThreshold false .
    BIND(ffv:AudioImageConflict AS ?type)
    BIND("Audio detects an explosion above threshold, but the image fire score is below threshold." AS ?why)
    BIND(?ev AS ?anchor)
  }
  UNION
  {
    # (b) caption mentions a class that the classifier scored below threshold
    ?i a ffonto:ImageRecord ; ffonto:hasCaption ?cap ; ffonto:hasObservation ?o2 .
    ?cap ffonto:mentionsConcept ?cls .
    ?o2 ffonto:predictedClass ?cls ; ffonto:aboveThreshold false .
    OPTIONAL { ?i ffonto:aboutEvent ?ev }
    BIND(ffv:CaptionScoreConflict AS ?type)
    BIND(CONCAT("Caption mentions '", STRAFTER(STR(?cls), "#"), "' but the classifier score is below threshold.") AS ?why)
    BIND(?i AS ?anchor)
  }
  UNION
  {
    # (c) heavy rain recorded for the event while an image of the event shows smoke
    ?w a ffonto:WeatherRecord ; ffonto:aboutEvent ?ev ; ffonto:rainMm ?rain .
    FILTER(?rain > 10)
    ?i a ffonto:ImageRecord ; ffonto:aboutEvent ?ev ; ffonto:hasObservation ?o2 .
    ?o2 ffonto:predictedClass ffv:Smoke ; ffonto:aboveThreshold true .
    BIND(ffv:WeatherSmokeConflict AS ?type)
    BIND("More than 10 mm rain recorded for the event while smoke is detected in an image." AS ?why)
    BIND(?ev AS ?anchor)
  }
  BIND(IRI(CONCAT(STR(?anchor), "/conflict/", STRAFTER(STR(?type), "#"), "/",
                  MD5(CONCAT(COALESCE(STR(?o1), ""), STR(?o2))))) AS ?x)
}

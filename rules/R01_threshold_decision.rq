# RULE R01_threshold_decision
# Compare each observation's confidence with its threshold.
# Executed in file-name order by scripts/run_cqs.py (CONSTRUCT results are added to the graph).

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffv:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

CONSTRUCT { ?o ffonto:aboveThreshold ?above }
WHERE {
  ?o ffonto:confidence ?conf ;
     ffonto:usedThreshold/ffonto:thresholdValue ?thr .
  BIND(?conf >= ?thr AS ?above)
}

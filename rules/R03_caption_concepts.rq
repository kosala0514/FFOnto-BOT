# RULE R03_caption_concepts
# Tag captions with the concepts whose labels / keywords appear in the caption text (whole-word match).
# Executed in file-name order by scripts/run_cqs.py (CONSTRUCT results are added to the graph).

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffv:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

CONSTRUCT { ?cap ffonto:mentionsConcept ?c }
WHERE {
  ?cap a ffonto:Caption ;
       ffonto:captionText ?text .
  VALUES ?scheme { ffv:DetectionClassScheme ffv:EntityKindScheme }
  ?c skos:inScheme ?scheme ;
     skos:hiddenLabel ?kw .
  BIND(CONCAT(" ", LCASE(REPLACE(STR(?text), "[^A-Za-z0-9]+", " ")), " ") AS ?norm)
  FILTER(CONTAINS(?norm, CONCAT(" ", LCASE(STR(?kw)), " ")))
}

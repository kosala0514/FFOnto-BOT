# RULE R06_scene_hazards
# Derive hazards from scene descriptions (feeds CQ24/CQ25). Each UNION branch is one hazard rule — add or tune rules here.
# Executed in file-name order by scripts/run_cqs.py (CONSTRUCT results are added to the graph).

PREFIX ffonto:  <http://purl.org/ffonto#>
PREFIX ffontov:  <http://purl.org/ffonto/vocab#>
PREFIX ffd:  <http://purl.org/ffonto/data/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

CONSTRUCT {
  ?h a ffonto:Hazard ;
     ffonto:hasHazardType ?ht ;
     ffonto:threatens ?target ;
     ffonto:inEvent ?ev ;
     prov:wasDerivedFrom ?src ;
     rdfs:comment ?why .
}
WHERE {
  {
    ?sd ffonto:depicts ?target , ?src .
    ?target ffonto:hasKind/skos:broader* ffontov:Person .
    ?src ffonto:hasKind/skos:broader* ffontov:FirePhenomenonKind .
    ?target ffonto:near|^ffonto:near ?src .
    BIND(ffontov:FlameProximity AS ?ht)
    BIND("Person depicted near a fire phenomenon." AS ?why)
  }
  UNION
  {
    ?sd ffonto:depicts ?target , ?src .
    ?target ffonto:hasKind/skos:broader* ffontov:Building .
    ?src ffonto:hasKind/skos:broader* ffontov:FirePhenomenonKind .
    ?src ffonto:advancingToward|ffonto:near|^ffonto:near ?target .
    BIND(ffontov:StructureIgnitionRisk AS ?ht)
    BIND("Fire phenomenon near / advancing toward a building." AS ?why)
  }
  UNION
  {
    ?sd ffonto:depicts ?target .
    ?target ffonto:hasKind/skos:broader* ffontov:Building ;
            ffonto:hasState ffontov:Threatened .
    BIND(?target AS ?src)
    BIND(ffontov:StructureIgnitionRisk AS ?ht)
    BIND("Building marked as threatened by the scene extractor." AS ?why)
  }
  UNION
  {
    ?sd ffonto:depicts ?target , ?src .
    ?target ffonto:hasKind ffontov:PropaneTank .
    ?src ffonto:hasKind/skos:broader* ffontov:FirePhenomenonKind .
    ?target ffonto:near|^ffonto:near ?src .
    BIND(ffontov:ExplosionHazard AS ?ht)
    BIND("Pressurised tank near a fire phenomenon." AS ?why)
  }
  UNION
  {
    ?sd ffonto:hasObservation ?src ; ffonto:depicts ?target .
    ?src sosa:observedProperty ffontov:VisibilityLevel ; ffonto:hasValueConcept ffontov:Low .
    VALUES ?k { ffontov:Road ffontov:GroundVehicle ffontov:Aircraft }
    ?target ffonto:hasKind/skos:broader* ?k .
    BIND(ffontov:SmokeVisibilityHazard AS ?ht)
    BIND("Low visibility while a road, vehicle or aircraft is in the scene." AS ?why)
  }
  UNION
  {
    ?sd ffonto:hasObservation ?src ; ffonto:depicts ?target .
    ?src sosa:observedProperty ffontov:SmokeDensity ; ffonto:hasValueConcept ?dens .
    VALUES ?dens { ffontov:High ffontov:Extreme }
    ?target ffonto:hasKind/skos:broader* ffontov:Person .
    BIND(ffontov:RespiratoryHazard AS ?ht)
    BIND("Dense smoke with people present." AS ?why)
  }
  UNION
  {
    ?sd ffonto:depicts ?target .
    VALUES ?k { ffontov:PowerLine ffontov:PowerPole ffontov:Transformer }
    VALUES ?st { ffontov:Down ffontov:Damaged ffontov:OnFire ffontov:Leaning }
    ?target ffonto:hasKind ?k ; ffonto:hasState ?st .
    BIND(?target AS ?src)
    BIND(ffontov:DownedPowerLineHazard AS ?ht)
    BIND("Power infrastructure down, damaged or burning." AS ?why)
  }
  UNION
  {
    ?sd ffonto:depicts ?target .
    ?target ffonto:hasKind ?k .
    ?k ffonto:requiredPPE ?ppe .
    FILTER NOT EXISTS { ?target ffonto:wears ?ppe }
    BIND(?target AS ?src)
    BIND(ffontov:MissingPPEHazard AS ?ht)
    BIND("Person not seen wearing an item of required PPE." AS ?why)
  }
  UNION
  {
    ?sd ffonto:hasObservation ?src ; ffonto:depicts ?target .
    ?src sosa:observedProperty ffontov:FireIntensity ; ffonto:hasValueConcept ?lvl .
    VALUES ?lvl { ffontov:High ffontov:Extreme }
    VALUES ?k { ffontov:ConiferousForest ffontov:LadderFuel }
    ?target ffonto:hasKind ?k .
    BIND(ffontov:CrownFireTransition AS ?ht)
    BIND("High fire intensity next to conifers or ladder fuels." AS ?why)
  }
  UNION
  {
    ?sd ffonto:depicts ?src .
    VALUES ?k { ffontov:SpotFire ffontov:Ember }
    ?src ffonto:hasKind ?k .
    BIND(ffontov:SpottingHazard AS ?ht)
    BIND("Spot fires or embers visible." AS ?why)
  }
  UNION
  {
    ?sd ffonto:depicts ?target .
    ?target ffonto:hasKind ffontov:Road ; ffonto:hasState ffontov:Blocked .
    BIND(?target AS ?src)
    BIND(ffontov:EvacuationRouteBlocked AS ?ht)
    BIND("Road marked as blocked." AS ?why)
  }
  UNION
  {
    ?sd ffonto:depicts ?src .
    { ?src ffonto:hasKind ffontov:Snag }
    UNION
    { ?src ffonto:hasKind ffontov:Tree . VALUES ?st { ffontov:Dead ffontov:Charred } ?src ffonto:hasState ?st }
    BIND(ffontov:FallingTreeHazard AS ?ht)
    BIND("Snags or dead / charred trees visible." AS ?why)
  }
  UNION
  {
    ?sd ffonto:depicts ?src .
    { VALUES ?k { ffontov:Smouldering ffontov:Hotspot } ?src ffonto:hasKind ?k }
    UNION
    { ?src ffonto:hasState ffontov:SmoulderingState }
    BIND(ffontov:ReignitionHazard AS ?ht)
    BIND("Smouldering material or hotspots visible." AS ?why)
  }
  UNION
  {
    ?sd ffonto:depicts ?src .
    VALUES ?k { ffontov:ErosionRill ffontov:ExposedMineralSoil }
    ?src ffonto:hasKind ?k .
    BIND(ffontov:ErosionRisk AS ?ht)
    BIND("Erosion rills or exposed mineral soil visible." AS ?why)
  }
  UNION
  {
    ?sd ffonto:depicts ?target , ?src .
    ?target ffonto:hasKind/skos:broader* ffontov:Animal .
    ?src ffonto:hasKind/skos:broader* ffontov:FirePhenomenonKind .
    ?target ffonto:near|^ffonto:near ?src .
    BIND(ffontov:WildlifeThreat AS ?ht)
    BIND("Animals near a fire phenomenon." AS ?why)
  }
  OPTIONAL { ?sd ffonto:describesRecord/ffonto:aboutEvent ?ev }
  BIND(IRI(CONCAT(STR(?sd), "/hazard/", STRAFTER(STR(?ht), "#"), "/",
                  MD5(COALESCE(STR(?target), STR(?src))))) AS ?h)
}

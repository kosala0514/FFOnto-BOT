# FFOnto custom check: a concept must have a broader concept or be a top concept
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?entity ?property ?value WHERE {
  ?entity a skos:Concept .
  FILTER NOT EXISTS { ?entity skos:broader ?b }
  FILTER NOT EXISTS { ?entity skos:topConceptOf ?s }
  BIND(skos:broader AS ?property)
}

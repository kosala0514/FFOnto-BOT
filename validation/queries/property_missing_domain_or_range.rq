# FFOnto custom check (INFO): ffo properties without rdfs:domain or rdfs:range.
# Some are intentional (e.g. ffonto:threatens can point to an entity or a concept).
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?entity ?property ?value WHERE {
  VALUES ?type { owl:ObjectProperty owl:DatatypeProperty }
  ?entity a ?type .
  FILTER(STRSTARTS(STR(?entity), "http://purl.org/ffonto#"))
  { FILTER NOT EXISTS { ?entity rdfs:domain ?d } BIND(rdfs:domain AS ?property) }
  UNION
  { FILTER NOT EXISTS { ?entity rdfs:range ?r }  BIND(rdfs:range AS ?property) }
}
